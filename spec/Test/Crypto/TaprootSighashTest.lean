/-- The reject lane (no expected digest — the def must return `none`):
undefined hashtype (TPR-030) and SINGLE without the corresponding output
(TPR-042). -/
def negativeCases : List (String × Nat × Nat) :=
  [("tapsh-badhashtype", 0, 5),
   ("tapsh-single-noout", 5, 131)]

/-- The `ScriptExecutionData` for a harness row: key path unless a
tapleaf hash is given; the annex hash slot carries `shaAnnex` of the row's
annex bytes (Core computes the same at interpreter.cpp:1964). -/
def execData (annexHex leafHex : String) (cs : UInt32) : ScriptExecutionData :=
  let annex : Option ByteArray :=
    if annexHex = "" then none else some (shaAnnex (fromHex annexHex))
  if leafHex = "" then
    { annexInit := true, annexPresent := annex.isSome
      annexHash := annex.getD ByteArray.empty }
  else
    { annexInit := true, annexPresent := annex.isSome
      annexHash := annex.getD ByteArray.empty
      tapleafHashInit := true, tapleafHash := fromHex leafHex
      codesepPosInit := true, codesepPos := cs }

/-! ## IO harness: the vectors through `sigMsgTaproot`/`sighashTaproot` -/

def checkOne (tx : Tx) (v : String × Nat × Nat × String × String × UInt32 × String × String) :
    IO Bool := do
  let (name, inPos, htN, annexHex, leafHex, cs, msgH, hashH) := v
  let env : TapSighashEnv := ⟨tx, utxos.map (fun p => ⟨p.1, ⟨fromHex p.2⟩⟩)⟩
  let ht : UInt8 := htN.toUInt8
  let sv := if leafHex = "" then SigVersion.taproot else SigVersion.tapscript
  let d := execData annexHex leafHex cs
  match sigMsgTaproot env inPos ht sv d, sighashTaproot env inPos ht sv d with
  | some m, some h =>
      let msgOk := bytesBEq (serU8 0 ++ m) (fromHex msgH)
      let hashOk := bytesBEq h (fromHex hashH)
      unless msgOk && hashOk do
        IO.println s!"FAIL {name}: msgOk {msgOk} hashOk {hashOk}"
      pure (msgOk && hashOk)
  | _, _ =>
      IO.println s!"FAIL {name}: sighash lane returned none"
      pure false

def runVectors : IO Unit := do
  match decodeTx (fromHex rawTxHex) with
  | .error _ => throw (IO.userError "decodeTx failed on the corpus rawUnsignedTx")
  | .ok tx =>
    let mut fails := 0
    for v in vectors do
      unless ← checkOne tx v do
        fails := fails + 1
    for (name, inPos, htN) in negativeCases do
      let env : TapSighashEnv := ⟨tx, utxos.map (fun p => ⟨p.1, ⟨fromHex p.2⟩⟩)⟩
      let d : ScriptExecutionData := { annexInit := true }
      if (sigMsgTaproot env inPos htN.toUInt8 SigVersion.taproot d).isSome then
        fails := fails + 1
        IO.println s!"FAIL {name}: expected none (reject lane)"
    let nSynth := vectors.length - 7
    IO.println s!"BIP341 sighash: {vectors.length} sigMsg/sigHash cases \
      ({7} official + {nSynth} synthetic annex/tapscript) + \
      {negativeCases.length} rejects, FAILURES {fails}"
    if fails > 0 then throw (IO.userError "BIP341 sighash conformance failures")

end Bitcoin.Test.Crypto.TaprootSighashVectors

/-- Runner entry (root `main` for `lake env lean --run`). -/
def main : IO Unit := Bitcoin.Test.Crypto.TaprootSighashVectors.runVectors
