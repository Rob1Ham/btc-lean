import Bitcoin.Numeric.Amount

/-!
# Bitcoin.Numeric.Tests — test vectors

Compile-time `decide`-theorems pinning the vector suite. Every
expected value in this file was generated by an independent Python
model of `CScriptNum` (the script-number notes §5,
vector script cross-checked against bitcoin/src/script/script.h
:227-394 and interpreter.cpp:46-59).

Conventions: wire byte lists are little-endian (Core's `vch` order),
fed through `bytesFromLE`; `bytesOf` reads a `ByteArray` back out as a
`List Nat` for decidable comparison. `0x80 = 128` is the sign flag.
-/

namespace Bitcoin.Numeric

open Bitcoin.Data

/-! ## Encode (CScriptNum::serialize, script.h:342-373) -/

theorem vec_encode_zero : bytesOf (encodeScriptNum 0 false) = [] := by decide

theorem vec_encode_one : bytesOf (encodeScriptNum 1 false) = [0x01] := by decide

theorem vec_encode_neg_one : bytesOf (encodeScriptNum (-1) false) = [0x81] := by decide

theorem vec_encode_127 : bytesOf (encodeScriptNum 127 false) = [0x7f] := by decide

theorem vec_encode_128 : bytesOf (encodeScriptNum 128 false) = [0x80, 0x00] := by decide

theorem vec_encode_neg_128 : bytesOf (encodeScriptNum (-128) false) = [0x80, 0x80] := by decide

theorem vec_encode_255 : bytesOf (encodeScriptNum 255 false) = [0xff, 0x00] := by decide

theorem vec_encode_256 : bytesOf (encodeScriptNum 256 false) = [0x00, 0x01] := by decide

theorem vec_encode_32768 : bytesOf (encodeScriptNum 32768 false) = [0x00, 0x80, 0x00] := by decide

theorem vec_encode_i32max : bytesOf (encodeScriptNum 2147483647 false) =
    [0xff, 0xff, 0xff, 0x7f] := by decide

theorem vec_encode_neg_i32max : bytesOf (encodeScriptNum (-2147483647) false) =
    [0xff, 0xff, 0xff, 0xff] := by decide

/-! The canonical encoding of −2^31 is 5 bytes — the only value whose
minimal encoding exceeds the default 4-byte width (script.h:252-268
comment). -/
theorem vec_encode_int64_min_corner :
    bytesOf (encodeScriptNum (-2147483648) false) =
      [0x00, 0x00, 0x00, 0x80, 0x80] := by decide

/-! ## Decode, minimal = true (default; interpreter.cpp:429-451) -/

theorem vec_decode_128 : decodeScriptNum (bytesFromLE [0x80, 0x00]) true 4 = some 128 := by decide

theorem vec_decode_neg_128 : decodeScriptNum (bytesFromLE [0x80, 0x80]) true 4 = some (-128) := by decide

theorem vec_decode_32768 : decodeScriptNum (bytesFromLE [0x00, 0x80, 0x00]) true 4 = some 32768 := by decide

theorem vec_decode_i32max :
    decodeScriptNum (bytesFromLE [0xff, 0xff, 0xff, 0x7f]) true 4 = some 2147483647 := by decide

theorem vec_decode_neg_i32max :
    decodeScriptNum (bytesFromLE [0xff, 0xff, 0xff, 0xff]) true 4 = some (-2147483647) := by decide

theorem vec_decode_int64_min_corner :
    decodeScriptNum (bytesFromLE [0x00, 0x00, 0x00, 0x80, 0x80]) true 5 = some (-2147483648) := by decide

/-- The same 5-byte value refuses the default 4-byte width. -/
theorem vec_decode_int64_min_corner_4 :
    decodeScriptNum (bytesFromLE [0x00, 0x00, 0x00, 0x80, 0x80]) true 4 = none := by decide

/-! ## Minimal-encoding rejections (SCR-084; script.h:252-268) -/

theorem vec_reject_00 : decodeScriptNum (bytesFromLE [0x00]) true 4 = none := by decide

theorem vec_reject_80 : decodeScriptNum (bytesFromLE [0x80]) true 4 = none := by decide

theorem vec_reject_0000 : decodeScriptNum (bytesFromLE [0x00, 0x00]) true 4 = none := by decide

theorem vec_reject_0100 : decodeScriptNum (bytesFromLE [0x01, 0x00]) true 4 = none := by decide

theorem vec_reject_800000 : decodeScriptNum (bytesFromLE [0x80, 0x00, 0x00]) true 4 = none := by decide

/-! ## Decode, minimal = false (non-minimal accepted) -/

theorem vec_nonminimal_80 : decodeScriptNum (bytesFromLE [0x80]) false 4 = some 0 := by decide

theorem vec_nonminimal_0100 : decodeScriptNum (bytesFromLE [0x01, 0x00]) false 4 = some 1 := by decide

/-- `00 00 00 80` is the negative zero: decodes to 0 when minimal is
not required (and its `CastToBool` is false — see below). -/
theorem vec_nonminimal_00000080 :
    decodeScriptNum (bytesFromLE [0x00, 0x00, 0x00, 0x80]) false 4 = some 0 := by decide

/-! ## Roundtrip sweep (encode → decode) -/

theorem vec_roundtrip_sweep :
    decodeScriptNum (encodeScriptNum 0 true) true 4 = some 0
    ∧ decodeScriptNum (encodeScriptNum 1 true) true 4 = some 1
    ∧ decodeScriptNum (encodeScriptNum (-1) true) true 4 = some (-1)
    ∧ decodeScriptNum (encodeScriptNum 127 true) true 4 = some 127
    ∧ decodeScriptNum (encodeScriptNum 128 true) true 4 = some 128
    ∧ decodeScriptNum (encodeScriptNum (-128) true) true 4 = some (-128)
    ∧ decodeScriptNum (encodeScriptNum 255 true) true 4 = some 255
    ∧ decodeScriptNum (encodeScriptNum 256 true) true 4 = some 256
    ∧ decodeScriptNum (encodeScriptNum 32767 true) true 4 = some 32767
    ∧ decodeScriptNum (encodeScriptNum 32768 true) true 4 = some 32768
    ∧ decodeScriptNum (encodeScriptNum (-32768) true) true 4 = some (-32768)
    ∧ decodeScriptNum (encodeScriptNum 100000000 true) true 4 = some 100000000
    ∧ decodeScriptNum (encodeScriptNum 2147483647 true) true 4 = some 2147483647
    ∧ decodeScriptNum (encodeScriptNum (-2147483647) true) true 4 = some (-2147483647) := by
  decide

/-- MAX_MONEY-scale amounts (2.1e15) do NOT roundtrip through the
default 4-byte `CScriptNum` decode — script integers are bounded by
2^31−1 (callers must not use `decodeScriptNum` for value sums). -/
theorem vec_max_money_not_scriptnum :
    decodeScriptNum (encodeScriptNum 2100000000000000 true) true 4 = none := by
  decide

/-! ## CastToBool (interpreter.cpp:46-59; SCR-057/083) -/

theorem vec_bool_empty : castToBool (bytesFromLE []) = false := by decide

theorem vec_bool_00 : castToBool (bytesFromLE [0x00]) = false := by decide

theorem vec_bool_80 : castToBool (bytesFromLE [0x80]) = false := by decide

theorem vec_bool_0080 : castToBool (bytesFromLE [0x00, 0x80]) = false := by decide

theorem vec_bool_8000 : castToBool (bytesFromLE [0x80, 0x00]) = true := by decide

theorem vec_bool_8080 : castToBool (bytesFromLE [0x80, 0x80]) = true := by decide

theorem vec_bool_ff : castToBool (bytesFromLE [0xff]) = true := by decide

theorem vec_bool_01 : castToBool (bytesFromLE [0x01]) = true := by decide

/-! ## GetInt (CScriptNum::Getint clamp, script.h:326-333) -/

theorem vec_clamp_id : getIntClamped 42 = 42 := by decide

theorem vec_clamp_id_neg : getIntClamped (-2147483648) = -2147483648 := by decide

theorem vec_clamp_max : getIntClamped 2147483648 = 2147483647 := by decide

theorem vec_clamp_min : getIntClamped (-2147483649) = -2147483648 := by decide

/-! ## Amount / fee arithmetic (tx_verify.cpp:186-216) -/

theorem vec_moneyRange_bounds :
    MoneyRange 0 = true
    ∧ MoneyRange MAX_MONEY = true
    ∧ MoneyRange (MAX_MONEY + 1) = false
    ∧ MoneyRange (-1) = false := by
  unfold MAX_MONEY COIN
  decide

theorem vec_fee_example : feeOf 1000 400 = 600 := by decide

theorem vec_fee_zero : feeOf 400 400 = 0 := by decide

theorem vec_fee_negative : feeOf 400 1000 = -600 := by decide

/-- MAX_MONEY literal: 2.1e15 satoshis (TXV-068). -/
theorem vec_max_money_literal : MAX_MONEY = 2100000000000000 := rfl

/-! ## Overflow story (CVE-2010-5137) -/

theorem vec_cve_true_sum :
    plainSum (List.replicate 8785 MAX_MONEY) = 18448500000000000000 := by
  exact cve2010_5137_true_sum

theorem vec_cve_checked_rejects :
    checkedSum (List.replicate 8785 MAX_MONEY) = none :=
  cve2010_5137_checkedSum_none

end Bitcoin.Numeric
