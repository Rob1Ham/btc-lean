import Bitcoin.Wallet.Psbt.Laws

/-!
# PSBT v0 — executable conformance corpus

Seven PSBT v0 byte strings, each checked with the pinned Bitcoin Core
node (`decodepsbt`, and `combinepsbt` re-serialisation for the
byte-identical claim).  The corpus covers a legacy P2PKH spend with a
non-witness UTXO, P2SH-P2WPKH, native P2WPKH with a global xpub, P2WSH
with a SHA256 preimage, taproot key-path spends, a taproot script-path
spend with an output tap tree, a finalized input, and unknown key-value
pairs at the global, input and output layer.

Every vector is checked for:

* successful decoding;
* `canonicalB` and `wellFormedB`;
* `encode (decode b) = b` (byte-identical re-encoding);
* `decode (encode p)` returning the same model (compared through the
  derived `Repr`, which covers every field including unknown pairs).

A separate variant writes the legacy vector's map entries in a different
order and checks that decoding is map-order independent while encoding
normalises back to the canonical order.  The remaining `#guard`s pin the
distinct decoding-error constructors.

The hex strings are generated by the PSBT vector script, which also
runs Core's `combinepsbt` and asserts the re-serialised bytes equal the
input.
-/

namespace Bitcoin.Wallet.Psbt.Tests

open Bitcoin.Wallet.Psbt
open Bitcoin.Data (toHex serTx)

/-! ## Test-only hex reader -/

/-- Value of one hexadecimal digit, in either case. -/
def hexDigitVal (c : Char) : Option Nat :=
  let n := c.toNat
  if 48 ≤ n ∧ n ≤ 57 then some (n - 48)
  else if 97 ≤ n ∧ n ≤ 102 then some (n - 87)
  else if 65 ≤ n ∧ n ≤ 70 then some (n - 55)
  else none

/-- Read a hex string into bytes; an incomplete final nibble is ignored. -/
def fromHex (s : String) : ByteArray :=
  go s.toList ByteArray.empty
where
  go : List Char → ByteArray → ByteArray
    | [], acc => acc
    | [_], acc => acc
    | a :: b :: rest, acc =>
        match hexDigitVal a, hexDigitVal b with
        | some hi, some lo => go rest (acc.push ((hi * 16 + lo).toUInt8))
        | _, _ => go (b :: rest) acc

/-! ## Corpus -/

/-- legacy_p2pkh -/
def legacy_p2pkh : String :=
  ""

/-- p2sh_p2wpkh -/
def p2sh_p2wpkh : String :=
  ""

/-- p2wpkh_xpub -/
def p2wpkh_xpub : String :=
  ""

/-- p2wsh -/
def p2wsh : String :=
  ""

/-- taproot_key -/
def taproot_key : String :=
  ""

/-- taproot_script -/
def taproot_script : String :=
  ""

/-- finalized_p2wpkh -/
def finalized_p2wpkh : String :=
  ""

/-- The canonical corpus, in order. -/
def allVectors : List (String × String) := [
  ("legacy_p2pkh", legacy_p2pkh),
  ("p2sh_p2wpkh", p2sh_p2wpkh),
  ("p2wpkh_xpub", p2wpkh_xpub),
  ("p2wsh", p2wsh),
  ("taproot_key", taproot_key),
  ("taproot_script", taproot_script),
  ("finalized_p2wpkh", finalized_p2wpkh)
]

/-- The legacy vector with the global and input map entries written in a
different order. -/
def orderVariant : String :=
  ""

/-! ## Vector checks -/

/-- All observable properties of one vector. -/
def checkVector (hex : String) : Bool :=
  let b := fromHex hex
  match decode b with
  | .error _ => false
  | .ok p =>
    toHex (encode p) == hex
    && canonicalB p
    && wellFormedB p
    && (match decode (encode p) with
        | .error _ => false
        | .ok q => reprStr q == reprStr p)

#guard (allVectors.all (fun (_, h) => checkVector h))

/-- Decoding is independent of map order. -/
def sameModel (a b : ByteArray) : Bool :=
  match decode a, decode b with
  | .ok p, .ok q => reprStr p == reprStr q
  | _, _ => false

#guard (sameModel (fromHex orderVariant) (fromHex legacy_p2pkh))

/-! A non-canonical map order normalises to the canonical bytes. -/
#guard (match decode (fromHex orderVariant) with
        | .ok p => toHex (encode p) == legacy_p2pkh
        | .error _ => false)

/-! Every vector's unsigned transaction survives a decode/encode cycle. -/
#guard (allVectors.all fun (_, h) =>
  match decode (fromHex h) with
  | .ok p =>
    match decode (encode p) with
    | .ok q => toHex (serTx q.global.unsignedTx) == toHex (serTx p.global.unsignedTx)
    | .error _ => false
  | .error _ => false)

/-! ## Extraction and finalization -/

/-! The finalized vector extracts to the unsigned transaction with the
final witness installed (base serialisation is unchanged because the
witness is not part of `serTx`). -/
#guard (match decode (fromHex finalized_p2wpkh) with
        | .ok p =>
          match p.inputs, extract p with
          | [i], some tx =>
            i.finalScriptWitness.isSome
            && toHex (serTx tx) == toHex (serTx p.global.unsignedTx)
          | _, _ => false
        | .error _ => false)

/-! Finalizing an input is idempotent and marks it signed. -/
#guard (match decode (fromHex p2wpkh_xpub) with
        | .ok p =>
          match p.inputs with
          | [i] =>
            let f := finalizeInput i (fromHex "51") []
            inputSigned f
            && reprStr (finalizeInput f (fromHex "51") []) == reprStr f
          | _ => false
        | .error _ => false)

/-! ## Error constructors -/

#guard (match decode (fromHex "00") with
        | .error .badMagic => true
        | _ => false)

#guard (match decode (fromHex "70736274ff01") with
        | .error .truncated => true
        | _ => false)

#guard (match decode (fromHex "70736274ff010700") with
        | .error .missingSeparator => true
        | _ => false)

#guard (match decode (fromHex "70736274ff01070001070000") with
        | .error (.duplicateKey k) => k == fromHex "07"
        | _ => false)

/-! A single-key field with non-empty key data is rejected, as Core's
`ExpectedKeySize(..., 1)` does. -/
#guard (match decode (fromHex "70736274ff0200010000") with
        | .error (.badKeySize f e a) =>
          f == "global unsigned tx" && e == 0 && a == 1
        | _ => false)

/-! An empty output tap-tree value is rejected
(`src/psbt.h:1151-1153`). -/
#guard (match parseOutput [(keyOf OUT_TAP_TREE ByteArray.empty, ByteArray.empty)] with
        | .error (.malformedValue f r) =>
          f == "output tap tree" && r == "empty tree"
        | _ => false)

#guard (match decode (fromHex (legacy_p2pkh ++ "00")) with
        | .error .trailingBytes => true
        | _ => false)

/-! A non-minimal CompactSize for the first key length is rejected. -/
#guard (match decode (fromHex "70736274fffd0100") with
        | .error .nonCanonicalCompactSize => true
        | _ => false)

/-! A CompactSize above `MAX_SIZE` is rejected. -/
#guard (match decode (fromHex "70736274ffff0100000002000000") with
        | .error .compactSizeTooLong => true
        | _ => false)

end Bitcoin.Wallet.Psbt.Tests
