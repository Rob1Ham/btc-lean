m <- llvm_load_module "ir20-proto/roots.bc";
thm <- llvm_verify m "_Zor19script_verify_flagsS_"
  [] false
  (do {
     x <- llvm_fresh_var "x" (llvm_int 64);
     y <- llvm_fresh_var "y" (llvm_int 64);
     llvm_execute_func [llvm_term x, llvm_term y];
     llvm_return (llvm_term {{ x || y }});
   })
  abc;
