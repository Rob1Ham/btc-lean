// SAW 1.6 consumes bitcode (not textual .ll). Raw rustc bitcode from
// 1.88/1.95 loads directly; 1.99's LLVM 23 bitstream is rejected.
m <- llvm_load_module "rust_hello_1.99.0.bc";
let add_spec = do {
  x <- llvm_fresh_var "x" (llvm_int 32);
  llvm_execute_func [llvm_term x];
  llvm_return (llvm_term {{ x + 1 : [32] }});
};
add_ms <- llvm_verify m "add_one" [] false add_spec abc;
print "SAW_1.99.0_OK";
