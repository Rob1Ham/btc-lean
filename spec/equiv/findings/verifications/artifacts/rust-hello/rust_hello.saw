// SAW 1.6 requires bitcode; rustc 1.88 raw .bc has bitstream format 14,
// which SAW rejects. llvm-dis/llvm-as at LLVM 20 normalizes it to format 5.
m <- llvm_load_module "add_one_norm.bc";
let add_spec = do {
  x <- llvm_fresh_var "x" (llvm_int 32);
  llvm_execute_func [llvm_term x];
  llvm_return (llvm_term {{ x + 1 : [32] }});
};
add_ms <- llvm_verify m "add_one" [] false add_spec abc;
print "SAW_RUST_188_NORMALIZED_OK";
