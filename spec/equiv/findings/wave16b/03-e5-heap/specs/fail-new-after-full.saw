// wave16b/03-e5-heap -- FAILURE DISCLOSURE (expected to fail).
//
// The arena is initialised already full (wave16b_off == CAP).  Calling
// _Znwm(16) must therefore take operator new's throw branch.  SAW must stop at
// the uninterpreted _ZSt17__throw_bad_allocv: that is the expected outcome and
// it demonstrates that the model does NOT hide allocation failure behind a
// null return or an assume.  "UNEXPECTED_SUCCESS" would be a modelling bug.
//
// Module: vec-probe-linked.bc (see build/build-heap-probe.sh).
m <- llvm_load_module "/tmp/opencode/wave16b-scratch/03-e5-heap/vec-probe-linked.bc";

let full_spec = do {
  llvm_alloc_global "wave16b_heap";
  llvm_alloc_global "wave16b_off";
  llvm_alloc_global "wave16b_alloc_calls";
  llvm_points_to (llvm_global "wave16b_off") (llvm_term {{ 67108864 : [64] }});
  llvm_points_to (llvm_global "wave16b_alloc_calls") (llvm_term {{ 0 : [64] }});
  llvm_execute_func [];
  llvm_return (llvm_term {{ 0 : [64] }});
};

llvm_verify m "w16b_new_after_full" [] false full_spec z3;
print "UNEXPECTED_SUCCESS";
