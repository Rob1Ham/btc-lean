// wave16b/03-e5-heap -- INSTRUMENTED OP_1 run (allocation-size measurement).
//
// Same input and allocator as e5-verifyscript-op1-heapmodel.saw, but the
// module is built with models/alloc-instrumented.ll, which additionally
// records the first and last requested size in two globals.  The postcondition
// asserts first_n == 1, last_n == 24, so a successful proof is a machine-
// checked allocation trace for this path (the bump offset is measured
// separately by asserting on wave16b_off; see README section 3.1).
//
// Build (writes only under /tmp/opencode/wave16b-scratch/03-e5-heap):
//   llvm-as models/alloc-instrumented.ll -o $OUT/alloc-instrumented.bc
//   llvm-link $ROOTS3 $OUT/alloc-instrumented.bc -o $OUT/probe-instr.bc
//
// No llvm_unsafe_assume_spec.
m <- llvm_load_module "/tmp/opencode/wave16b-scratch/03-e5-heap/probe-instr.bc";

let verify_script = "_Z12VerifyScriptRK7CScriptS1_PK14CScriptWitness19script_verify_flagsRK20BaseSignatureCheckerP13ScriptError_t";

thm <- llvm_verify m verify_script [] false
  (do {
     llvm_alloc_global "wave16b_heap";
     llvm_alloc_global "wave16b_off";
     llvm_alloc_global "wave16b_alloc_calls";
     llvm_alloc_global "wave16b_first_n";
     llvm_alloc_global "wave16b_last_n";
     llvm_points_to (llvm_global "wave16b_off") (llvm_term {{ 0 : [64] }});
     llvm_points_to (llvm_global "wave16b_alloc_calls") (llvm_term {{ 0 : [64] }});
     llvm_points_to (llvm_global "wave16b_first_n") (llvm_term {{ 0 : [64] }});
     llvm_points_to (llvm_global "wave16b_last_n") (llvm_term {{ 0 : [64] }});
     ss  <- llvm_alloc_aligned 8 (llvm_array 40 (llvm_int 8));
     spk <- llvm_alloc_aligned 8 (llvm_array 40 (llvm_int 8));
     chk <- llvm_alloc_aligned 8 (llvm_array 8 (llvm_int 8));
     err <- llvm_alloc_aligned 8 (llvm_array 8 (llvm_int 8));
     llvm_points_to ss  (llvm_term {{ zero : [40][8] }});
     llvm_points_to spk (llvm_term {{ ([0x51] # (zero : [35][8]) # [0x01,0x00,0x00,0x00]) : [40][8] }});
     llvm_points_to chk (llvm_term {{ zero : [8][8] }});
     llvm_points_to err (llvm_term {{ zero : [8][8] }});
     llvm_execute_func [ss, spk, llvm_term {{ 0 : [64] }},
                        llvm_term {{ 0 : [64] }}, chk, err];
     llvm_points_to (llvm_global "wave16b_first_n") (llvm_term {{ 1 : [64] }});
     llvm_points_to (llvm_global "wave16b_last_n") (llvm_term {{ 24 : [64] }});
     llvm_return (llvm_term {{ 1 : [1] }});
   }) z3;

print "W16B_E5_OP1_INSTRUMENTED_DONE";
