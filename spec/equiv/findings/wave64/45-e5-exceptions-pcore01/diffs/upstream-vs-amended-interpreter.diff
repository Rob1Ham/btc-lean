+/** Non-throwing replacement for CScriptNum(vch, ...) at every engine call
+ *  site: sets SCRIPT_ERR_SCRIPTNUM exactly where the old catch block did. */
+static bool GetScriptNum(const std::vector<unsigned char>& vch, bool fRequireMinimal,
+                         size_t nMaxNumSize, CScriptNum& out, ScriptError* serror)
