// wave64/44-e5-heap-refinement -- real-libstdc++ vector-growth refinement leaf.
//
// Generated by build/gen_vec_growth.py for a concrete K.  Two functions:
//
//   w64_growth_bound_K(seed): drives K pushes on
//       std::vector<std::vector<unsigned char>> (the EvalScript stack shape),
//       then returns 1 only if
//         * size == K,
//         * capacity == the libstdc++ doubling value (NEXT_CAP),
//         * v[i] == seed+i for every i,
//         * the model's cumulative bump cursor w64_off <= BOUND,
//         * the model observed at least one allocation.
//     BOUND is computed by gen_vec_growth.py from the request-size/growth
//     formula, independently of the executed trace.  A SAW proof of return 1
//     is therefore a proof that the real libstdc++ growth path stays inside
//     the stated cumulative bound.
//
//   w64_growth_bad_K(seed): identical, but the bound is BAD_BOUND = BOUND-1.
//     The companion SAW run is EXPECTED TO FAIL.  If it did not, the bound
//     proof would be vacuous; together the two runs pin the cumulative bytes
//     to exactly BOUND for this shape.

#include <cstddef>
#include <vector>

extern "C" unsigned long long w64_off;
extern "C" unsigned long long w64_calls;

static int check(std::vector<std::vector<unsigned char>>& st,
                 unsigned char seed, unsigned long long bound) {
    if (st.size() != static_cast<std::size_t>(@K@)) return 0;
    if (st.capacity() != static_cast<std::size_t>(@NEXT_CAP@)) return 0;
    for (int i = 0; i < @K@; ++i) {
        if (st[static_cast<std::size_t>(i)].size() != 1) return 0;
        if (st[static_cast<std::size_t>(i)][0] !=
            static_cast<unsigned char>(seed + static_cast<unsigned char>(i))) return 0;
    }
    if (w64_off > bound) return 0;
    if (w64_calls == 0) return 0;
    return 1;
}

extern "C" unsigned w64_growth_bound_@K@(unsigned char seed) {
    std::vector<std::vector<unsigned char>> st;
    for (int i = 0; i < @K@; ++i) {
        st.push_back(std::vector<unsigned char>(
            1, static_cast<unsigned char>(seed + static_cast<unsigned char>(i))));
    }
    return static_cast<unsigned>(check(st, seed, @BOUND@ULL));
}

extern "C" unsigned w64_growth_bad_@K@(unsigned char seed) {
    std::vector<std::vector<unsigned char>> st;
    for (int i = 0; i < @K@; ++i) {
        st.push_back(std::vector<unsigned char>(
            1, static_cast<unsigned char>(seed + static_cast<unsigned char>(i))));
    }
    return static_cast<unsigned>(check(st, seed, @BAD_BOUND@ULL));
}
