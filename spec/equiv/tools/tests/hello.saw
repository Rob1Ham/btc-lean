// E0 SAW hello-world: verify trivial C functions against Cryptol specs.
m <- llvm_load_module "hello.bc";

let id_spec = do {
  x <- llvm_fresh_var "x" (llvm_int 32);
  llvm_execute_func [llvm_term x];
  llvm_return (llvm_term x);
};

let add_spec = do {
  x <- llvm_fresh_var "x" (llvm_int 32);
  llvm_precond {{ x < 2147483647 }};
  llvm_execute_func [llvm_term x];
  llvm_return (llvm_term {{ x + 1 : [32] }});
};

id_ms  <- llvm_verify m "id32"    [] false id_spec  abc;
add_ms <- llvm_verify m "add_one" [] false add_spec abc;
print "SAW_E0_HELLO_OK";
