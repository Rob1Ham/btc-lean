+#ifdef BTC_EQUIV_DEVIRT
+/* Equivalence lane: the engine is only ever driven by one checker, supplied by
+ * the harness shim. Replace vtable dispatch with direct calls into four
+ * extern "C" hooks; no engine behavior changes because the dispatch had a
+ * single concrete target in this build. */
+extern "C" {
+bool btc_equiv_check_ecdsa(const void* ctx, const unsigned char* sig, size_t sig_len, const unsigned char* pubkey, size_t pubkey_len, const unsigned char* script, size_t script_len, int sigversion);
+bool btc_equiv_check_schnorr(const void* ctx, const unsigned char* sig, size_t sig_len, const unsigned char* pubkey, size_t pubkey_len, int sigversion, void* execdata, void* serror);
+bool btc_equiv_check_locktime(const void* ctx, int64_t n);
+bool btc_equiv_check_sequence(const void* ctx, int64_t n);
+}
+
+class BaseSignatureChecker
+{
+public:
+    explicit BaseSignatureChecker(const void* ctx = nullptr) : m_ctx{ctx} {}
+    bool CheckECDSASignature(const std::vector<unsigned char>& scriptSig, const std::vector<unsigned char>& vchPubKey, const CScript& scriptCode, SigVersion sigversion) const
+    {
+        return btc_equiv_check_ecdsa(m_ctx, scriptSig.data(), scriptSig.size(), vchPubKey.data(), vchPubKey.size(), scriptCode.data(), scriptCode.size(), static_cast<int>(sigversion));
+    }
+    bool CheckSchnorrSignature(std::span<const unsigned char> sig, std::span<const unsigned char> pubkey, SigVersion sigversion, ScriptExecutionData& execdata, ScriptError* serror = nullptr) const
+    {
+        return btc_equiv_check_schnorr(m_ctx, sig.data(), sig.size(), pubkey.data(), pubkey.size(), static_cast<int>(sigversion), &execdata, serror);
+    }
+    bool CheckLockTime(const CScriptNum& nLockTime) const
+    {
+        return btc_equiv_check_locktime(m_ctx, nLockTime.GetInt64());
+    }
+    bool CheckSequence(const CScriptNum& nSequence) const
+    {
+        return btc_equiv_check_sequence(m_ctx, nSequence.GetInt64());
+    }
+    ~BaseSignatureChecker() = default;
+private:
+    const void* m_ctx;
+};
+#define BTC_EQUIV_OVERRIDE
+#else
