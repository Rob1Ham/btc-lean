import "cell.cry";

mC <- llvm_load_module "c_cell_v0_cleanstack.bc";
mL <- llvm_load_module "l_cell_v0_cleanstack.bc";

let spec = do {
  n <- llvm_fresh_var "stack_size" (llvm_int 64);
  t <- llvm_fresh_var "top_truthy" (llvm_int 1);
  llvm_execute_func [llvm_term n, llvm_term {{ zext t : [64] }}];
  llvm_return (llvm_term {{ cleanstack n t }});
};

llvm_verify mC "cell_v0_cleanstack" [] false spec abc;
llvm_verify mL "cell_v0_cleanstack" [] false spec abc;

print "CELL_WITNESS_V0_CLEANSTACK_SAW_GREEN";
