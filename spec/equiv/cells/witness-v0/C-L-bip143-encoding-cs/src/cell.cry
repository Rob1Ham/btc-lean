module Spec where

// BIP143 WITNESS_V0 preimage field ORDER and integer-field ENCODING.
//
// The sibling cells C-L-bip143-layout and C-L-bip143-preimage-order treat
// every field payload as an opaque byte array.  This cell closes two of the
// limits those cells name explicitly:
//
//   1. integer field ENCODING — version, amount, nSequence, nLockTime and
//      nHashType are little-endian (serU32L / serAmountL, Digest.lean:53-64);
//   2. CompactSize ORDERING beyond one byte — encCSL (Interface.lean:493-500)
//      selects 1/3/5/9 bytes at the 0xfd / 0x10000 / 0x100000000 boundaries,
//      and the amount sits after the script at
//      105 + script_len + (encCS_width(script_len) - 1).
//
// The three sub-hashes, the transaction serializer, and SHA256d stay
// abstracted (spec/equiv/README.md §7); no transaction decode is claimed.

// Little-endian byte vectors: split gives most-significant chunk first, so
// reverse gives least-significant byte first.
le16 : [16] -> [2][8]
le16 w = reverse (split w)

le32 : [32] -> [4][8]
le32 w = reverse (split w)

le64 : [64] -> [8][8]
le64 w = reverse (split w)

// Low significance chunks of a 64-bit length, for the CompactSize payload.
low8 : [64] -> [8]
low8 n = (reverse (split n)) @ 0

low16 : [64] -> [16]
low16 n = (reverse (split n)) @ 0

low32 : [64] -> [32]
low32 n = (reverse (split n)) @ 0

// GetSizeOfCompactSize (serialize.h:291-297) / encCSL branch widths.
cs_width : [64] -> [64]
cs_width n = if n < 253 then 1
             else if n <= 65535 then 3
             else if n <= 4294967295 then 5
             else 9

// encCSL (Interface.lean:493-500), one branch at a time.
cs1 : [64] -> [1][8]
cs1 n = [low8 n]

cs3 : [64] -> [3][8]
cs3 n = [0xfd] # le16 (low16 n)

cs5 : [64] -> [5][8]
cs5 n = [0xfe] # le32 (low32 n)

cs9 : [64] -> [9][8]
cs9 n = [0xff] # le64 n

// Start of the 8-byte amount: fields before it are
// version(4) hashPrevouts(32) hashSequence(32) outpoint(36) = 104 bytes,
// then encCSL(script_len) ++ scriptCode, then amount.
amount_off : [64] -> [64]
amount_off script_len =
  105 + script_len + (cs_width script_len - 1)

// Full BIP143 preimage for a 253-byte scriptCode (encCSL 253 = fd fd 00).
// version(4) hashPrevouts(32) hashSequence(32) txid(32) vout(4)
// CompactSize(3) script(253) amount(8) nSequence(4) hashOutputs(32)
// nLockTime(4) nHashType(4) = 412 bytes.
preimage_e253 : [32] -> [32][8] -> [32][8] -> [32][8] -> [4][8]
             -> [253][8] -> [64] -> [32] -> [32][8] -> [32] -> [32]
             -> [412][8]
preimage_e253 version prevouts sequence txid vout script amount nseq
              outputs locktime hashtype =
  le32 version # prevouts # sequence # txid # vout
    # [0xfd, 0xfd, 0x00] # script
    # le64 amount # le32 nseq # outputs # le32 locktime # le32 hashtype

// SHA256d input length for the 253-byte scriptCode case.
digest_input_len_e253 : [64]
digest_input_len_e253 = 412
