import "cell.cry";

// Each function is verified on both legs against the same Cryptol spec.
// SAW 1.6, solver z3 (src/solver.txt).

mC <- llvm_load_module "c_leaf.bc";
mL <- llvm_load_module "l_leaf.bc";

// ---------------------------------------------------------------- LE encoders

let spec_ser_u32le = do {
  out <- llvm_alloc (llvm_array 4 (llvm_int 8));
  v   <- llvm_fresh_var "v" (llvm_int 32);
  llvm_execute_func [out, llvm_term v];
  llvm_points_to out (llvm_term {{ le32 v }});
  llvm_return (llvm_term {{ 4 : [64] }});
};

let spec_ser_u64le = do {
  out <- llvm_alloc (llvm_array 8 (llvm_int 8));
  v   <- llvm_fresh_var "v" (llvm_int 64);
  llvm_execute_func [out, llvm_term v];
  llvm_points_to out (llvm_term {{ le64 v }});
  llvm_return (llvm_term {{ 8 : [64] }});
};

// ------------------------------------------------------- CompactSize ordering

let spec_cs_width = do {
  n <- llvm_fresh_var "n" (llvm_int 64);
  llvm_execute_func [llvm_term n];
  llvm_return (llvm_term {{ cs_width n }});
};

let spec_cs1 = do {
  out <- llvm_alloc (llvm_array 1 (llvm_int 8));
  n   <- llvm_fresh_var "n" (llvm_int 64);
  llvm_precond {{ n <=$ 252 }};
  llvm_execute_func [out, llvm_term n];
  llvm_points_to out (llvm_term {{ cs1 n }});
  llvm_return (llvm_term {{ 1 : [64] }});
};

let spec_cs3 = do {
  out <- llvm_alloc (llvm_array 3 (llvm_int 8));
  n   <- llvm_fresh_var "n" (llvm_int 64);
  llvm_precond {{ (253 <=$ n) && (n <=$ 65535) }};
  llvm_execute_func [out, llvm_term n];
  llvm_points_to out (llvm_term {{ cs3 n }});
  llvm_return (llvm_term {{ 3 : [64] }});
};

let spec_cs5 = do {
  out <- llvm_alloc (llvm_array 5 (llvm_int 8));
  n   <- llvm_fresh_var "n" (llvm_int 64);
  llvm_precond {{ (65536 <=$ n) && (n <=$ 4294967295) }};
  llvm_execute_func [out, llvm_term n];
  llvm_points_to out (llvm_term {{ cs5 n }});
  llvm_return (llvm_term {{ 5 : [64] }});
};

let spec_cs9 = do {
  out <- llvm_alloc (llvm_array 9 (llvm_int 8));
  n   <- llvm_fresh_var "n" (llvm_int 64);
  llvm_precond {{ 4294967296 <=$ n }};
  llvm_execute_func [out, llvm_term n];
  llvm_points_to out (llvm_term {{ cs9 n }});
  llvm_return (llvm_term {{ 9 : [64] }});
};

// --------------------------------------- amount offset under CompactSize width

let spec_amount_off = do {
  l <- llvm_fresh_var "script_len" (llvm_int 64);
  // 0 .. 0xffffffff: every scriptCode length with a 1/3/5-byte prefix.
  // MAX_SIZE is 0x02000000 (Interface.lean:487-491), inside this domain.
  llvm_precond {{ l <=$ 4294967295 }};
  llvm_execute_func [llvm_term l];
  llvm_return (llvm_term {{ amount_off l }});
};

// ---------------------------------------------- 412-byte preimage, script 253

let spec_preimage_e253 = do {
  out  <- llvm_alloc (llvm_array 412 (llvm_int 8));
  php  <- llvm_alloc (llvm_array 32  (llvm_int 8));
  phs  <- llvm_alloc (llvm_array 32  (llvm_int 8));
  ptx  <- llvm_alloc (llvm_array 32  (llvm_int 8));
  pvo  <- llvm_alloc (llvm_array 4   (llvm_int 8));
  psc  <- llvm_alloc (llvm_array 253 (llvm_int 8));
  pho  <- llvm_alloc (llvm_array 32  (llvm_int 8));

  ver <- llvm_fresh_var "version"      (llvm_int 32);
  hp  <- llvm_fresh_var "hashPrevouts" (llvm_array 32  (llvm_int 8));
  hs  <- llvm_fresh_var "hashSequence" (llvm_array 32  (llvm_int 8));
  tx  <- llvm_fresh_var "txid"         (llvm_array 32  (llvm_int 8));
  vo  <- llvm_fresh_var "vout"         (llvm_array 4   (llvm_int 8));
  sc  <- llvm_fresh_var "script"       (llvm_array 253 (llvm_int 8));
  am  <- llvm_fresh_var "amount"       (llvm_int 64);
  sq  <- llvm_fresh_var "nSequence"    (llvm_int 32);
  ho  <- llvm_fresh_var "hashOutputs"  (llvm_array 32  (llvm_int 8));
  lk  <- llvm_fresh_var "nLockTime"    (llvm_int 32);
  ht  <- llvm_fresh_var "nHashType"    (llvm_int 32);

  llvm_points_to php (llvm_term hp);
  llvm_points_to phs (llvm_term hs);
  llvm_points_to ptx (llvm_term tx);
  llvm_points_to pvo (llvm_term vo);
  llvm_points_to psc (llvm_term sc);
  llvm_points_to pho (llvm_term ho);

  llvm_execute_func [out, llvm_term ver, php, phs, ptx, pvo, psc,
                     llvm_term am, llvm_term sq, pho, llvm_term lk,
                     llvm_term ht];

  llvm_points_to out
    (llvm_term {{ preimage_e253 ver hp hs tx vo sc am sq ho lk ht }});
  llvm_return (llvm_term {{ digest_input_len_e253 }});
};

// ---------------------------------------------------------------------- runs

llvm_verify mC "cell_ser_u32le" [] false spec_ser_u32le z3;
llvm_verify mL "cell_ser_u32le" [] false spec_ser_u32le z3;
llvm_verify mC "cell_ser_u64le" [] false spec_ser_u64le z3;
llvm_verify mL "cell_ser_u64le" [] false spec_ser_u64le z3;

llvm_verify mC "cell_cs_width" [] false spec_cs_width z3;
llvm_verify mL "cell_cs_width" [] false spec_cs_width z3;
llvm_verify mC "cell_cs1" [] false spec_cs1 z3;
llvm_verify mL "cell_cs1" [] false spec_cs1 z3;
llvm_verify mC "cell_cs3" [] false spec_cs3 z3;
llvm_verify mL "cell_cs3" [] false spec_cs3 z3;
llvm_verify mC "cell_cs5" [] false spec_cs5 z3;
llvm_verify mL "cell_cs5" [] false spec_cs5 z3;
llvm_verify mC "cell_cs9" [] false spec_cs9 z3;
llvm_verify mL "cell_cs9" [] false spec_cs9 z3;

llvm_verify mC "cell_bip143_amount_off" [] false spec_amount_off z3;
llvm_verify mL "cell_bip143_amount_off" [] false spec_amount_off z3;

llvm_verify mC "cell_bip143_preimage_e253" [] false spec_preimage_e253 z3;
llvm_verify mL "cell_bip143_preimage_e253" [] false spec_preimage_e253 z3;

print "CELL_BIP143_ENCODING_CS_SAW_GREEN";
