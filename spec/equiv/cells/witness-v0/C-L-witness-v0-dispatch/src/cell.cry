module Spec where

// Witness-v0 dispatch, version=0 arm of VerifyWitnessProgram.
// Inputs: program length, witness item count, and the abstracted
// SHA256(witnessScript)==program bit.  Output: wv_pack(result, error).
//   38 WRONG_LENGTH, 39 WITNESS_EMPTY, 40 MISMATCH; result 2 = continuation.
v0_dispatch : [64] -> [64] -> [1] -> [64]
v0_dispatch pl wn hm =
  if pl == 32 then
    if wn == 0 then 156                    // (0,39)
    else if hm == 0 then 160               // (0,40)
    else 2                                 // continue to ExecuteWitnessScript
  else if pl == 20 then
    if wn != 2 then 160                    // (0,40)
    else 2
  else 152                                 // (0,38)
