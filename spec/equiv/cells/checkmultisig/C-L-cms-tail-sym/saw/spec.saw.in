// SAW script template for the SCR-118/119/120 tail cell.  @CASE@ selects the
// shared checker stub instance; this cell does not call the checker (fSuccess
// is an input, so every verdict path is covered symbolically by the oracle).
import "model.cry";

mC <- llvm_load_module "c_saw_c@CASE@.bc";
mL <- llvm_load_module "l_saw_c@CASE@.bc";

let spec = do {
  nk  <- llvm_fresh_var "nkeys" (llvm_int 32);
  ns  <- llvm_fresh_var "nsigs" (llvm_int 32);
  ex  <- llvm_fresh_var "extra" (llvm_int 32);
  fs  <- llvm_fresh_var "fsuccess" (llvm_int 32);
  nd  <- llvm_fresh_var "nulldummy" (llvm_int 32);
  w   <- llvm_fresh_var "wire" (llvm_int 32);
  dl  <- llvm_fresh_var "dummylen" (llvm_int 32);
  db  <- llvm_fresh_var "dummybytes" (llvm_int 32);
  llvm_execute_func [llvm_term nk, llvm_term ns, llvm_term ex, llvm_term fs,
                     llvm_term nd, llvm_term w, llvm_term dl, llvm_term db];
  llvm_return (llvm_term {{ cms_tail nk ns ex fs nd w dl db }});
};

llvm_verify mC "cell_cms_tail" [] false spec abc;
llvm_verify mL "cell_cms_tail" [] false spec abc;
print "CASE_@CASE@_OK";
