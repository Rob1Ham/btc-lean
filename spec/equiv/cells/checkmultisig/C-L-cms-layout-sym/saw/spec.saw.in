// SAW script template for the SCR-114 layout cell.  @CASE@ selects the shared
// checker stub instance; this cell never calls the checker, so all cases are
// expected to prove the same thing and any case is a pure replay.
import "model.cry";

mC <- llvm_load_module "c_saw_c@CASE@.bc";
mL <- llvm_load_module "l_saw_c@CASE@.bc";

let spec = do {
  nk <- llvm_fresh_var "nk" (llvm_int 32);
  ns <- llvm_fresh_var "ns" (llvm_int 32);
  d  <- llvm_fresh_var "depth" (llvm_int 32);
  o  <- llvm_fresh_var "opcount" (llvm_int 32);
  llvm_execute_func [llvm_term nk, llvm_term ns, llvm_term d, llvm_term o];
  llvm_return (llvm_term {{ cms_layout nk ns d o }});
};

llvm_verify mC "cell_cms_layout" [] false spec abc;
llvm_verify mL "cell_cms_layout" [] false spec abc;
print "CASE_@CASE@_OK";
