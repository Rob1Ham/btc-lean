// SAW script template for the SCR-115 FindAndDelete-order cell.  @CASE@
// selects the checker stub: 0 always false (one body, early exit), 1 always
// true (both bodies).  The FindAndDelete seam stub is the same in both cases.
import "model.cry";

mC <- llvm_load_module "c_saw_c@CASE@.bc";
mL <- llvm_load_module "l_saw_c@CASE@.bc";

let spec = do {
  ns <- llvm_fresh_var "ns" (llvm_int 32);
  sv <- llvm_fresh_var "sv" (llvm_int 32);
  cf <- llvm_fresh_var "cf" (llvm_int 32);
  sc <- llvm_fresh_var "sc" (llvm_int 32);
  llvm_execute_func [llvm_term ns, llvm_term sv, llvm_term cf, llvm_term sc];
  llvm_return (llvm_term {{ cms_fad@CASE@ ns sv cf sc }});
};

llvm_verify mC "cell_cms_fad" [] false spec abc;
llvm_verify mL "cell_cms_fad" [] false spec abc;
print "CASE_@CASE@_OK";
