// SAW script template for the SCR-116 matching-order cell.  @CASE@ selects a
// concrete checker stub instance (match0..match4); Alive2 quantifies over the
// checker instead, so these are point checks of the ordering trace.
import "model.cry";

mC <- llvm_load_module "c_saw_c@CASE@.bc";
mL <- llvm_load_module "l_saw_c@CASE@.bc";

let spec = do {
  nk <- llvm_fresh_var "nk" (llvm_int 32);
  ns <- llvm_fresh_var "ns" (llvm_int 32);
  llvm_execute_func [llvm_term nk, llvm_term ns];
  llvm_return (llvm_term {{ order match@CASE@ nk ns }});
};

llvm_verify mC "cell_cms_order" [] false spec abc;
llvm_verify mL "cell_cms_order" [] false spec abc;
print "CASE_@CASE@_OK";
