import "cell.cry";

mC <- llvm_load_module "c_cell_is_p2sh.bc";
mCL <- llvm_load_module "l_cell_is_p2sh.bc";
mR <- llvm_load_module "c_cell_p2sh_reeval.bc";
mRL <- llvm_load_module "l_cell_p2sh_reeval.bc";

// --- 23-byte pattern predicate -------------------------------------------
let is_p2sh_spec = do {
  len <- llvm_fresh_var "len" (llvm_int 64);
  b0  <- llvm_fresh_var "b0"  (llvm_int 64);
  b1  <- llvm_fresh_var "b1"  (llvm_int 64);
  b22 <- llvm_fresh_var "b22" (llvm_int 64);
  llvm_execute_func [llvm_term len, llvm_term b0, llvm_term b1, llvm_term b22];
  llvm_return (llvm_term {{ is_p2sh len b0 b1 b22 }});
};
llvm_verify mC  "cell_is_p2sh" [] false is_p2sh_spec abc;
llvm_verify mCL "cell_is_p2sh" [] false is_p2sh_spec abc;

// --- restore stackCopy, pop redeem, re-evaluate as subscript --------------
let reeval_spec = do {
  ss_err       <- llvm_fresh_var "ss_err"       (llvm_int 64);
  ss_depth     <- llvm_fresh_var "ss_depth"     (llvm_int 64);
  ss_top       <- llvm_fresh_var "ss_top"       (llvm_int 64);
  ss_top_len   <- llvm_fresh_var "ss_top_len"   (llvm_int 64);
  hash_match   <- llvm_fresh_var "hash_match"   (llvm_int 64);
  pushonly_ok  <- llvm_fresh_var "pushonly_ok"  (llvm_int 64);
  redeem_err   <- llvm_fresh_var "redeem_err"   (llvm_int 64);
  redeem_depth <- llvm_fresh_var "redeem_depth" (llvm_int 64);
  redeem_top   <- llvm_fresh_var "redeem_top"   (llvm_int 64);
  redeem_len   <- llvm_fresh_var "redeem_top_len" (llvm_int 64);
  llvm_execute_func [llvm_term ss_err, llvm_term ss_depth, llvm_term ss_top,
                     llvm_term ss_top_len, llvm_term hash_match,
                     llvm_term pushonly_ok, llvm_term redeem_err,
                     llvm_term redeem_depth, llvm_term redeem_top,
                     llvm_term redeem_len];
  llvm_return (llvm_term {{ p2sh_reeval ss_err ss_depth ss_top ss_top_len
                               hash_match pushonly_ok redeem_err
                               redeem_depth redeem_top redeem_len }});
};
llvm_verify mR  "cell_p2sh_reeval" [] false reeval_spec abc;
llvm_verify mRL "cell_p2sh_reeval" [] false reeval_spec abc;

print "CELL_W32_P2SH_23BYTE_SAW_GREEN";
