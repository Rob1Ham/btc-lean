import "cell.cry";

mC <- llvm_load_module "c_cell_verify_sequential.bc";
mL <- llvm_load_module "l_cell_verify_sequential.bc";

let spec = do {
  ss_err     <- llvm_fresh_var "ss_err"     (llvm_int 64);
  ss_depth   <- llvm_fresh_var "ss_depth"   (llvm_int 64);
  ss_top     <- llvm_fresh_var "ss_top"     (llvm_int 64);
  ss_top_len <- llvm_fresh_var "ss_top_len" (llvm_int 64);
  llvm_execute_func [llvm_term ss_err, llvm_term ss_depth,
                     llvm_term ss_top, llvm_term ss_top_len];
  llvm_return (llvm_term {{ verify_sequential ss_err ss_depth ss_top ss_top_len }});
};

llvm_verify mC "cell_verify_sequential" [] false spec abc;
llvm_verify mL "cell_verify_sequential" [] false spec abc;

print "CELL_W32_VERIFY_SEQUENTIAL_SAW_GREEN";
