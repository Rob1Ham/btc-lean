import "cell.cry";

mC <- llvm_load_module "c_cell_witness_flag.bc";
mL <- llvm_load_module "l_cell_witness_flag.bc";

let spec = do {
  ss_err          <- llvm_fresh_var "ss_err"          (llvm_int 64);
  witness         <- llvm_fresh_var "witness"         (llvm_int 64);
  witness_nonempty<- llvm_fresh_var "witness_nonempty"(llvm_int 64);
  cleanstack      <- llvm_fresh_var "cleanstack"      (llvm_int 64);
  llvm_execute_func [llvm_term ss_err, llvm_term witness,
                     llvm_term witness_nonempty, llvm_term cleanstack];
  llvm_return (llvm_term {{ witness_flag ss_err witness witness_nonempty cleanstack }});
};

llvm_verify mC "cell_witness_flag" [] false spec abc;
llvm_verify mL "cell_witness_flag" [] false spec abc;

print "CELL_W32_WITNESS_FLAG_SAW_GREEN";
