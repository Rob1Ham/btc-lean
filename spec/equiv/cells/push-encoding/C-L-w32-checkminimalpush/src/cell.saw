import "cell.cry";
mC <- llvm_load_module "c_cell_minpush.bc";
mL <- llvm_load_module "l_cell_minpush.bc";

// Verify both legs against the same independent predicate for every bounded
// length (64-bit), first payload byte and call-site opcode.
let spec = do {
  n  <- llvm_fresh_var "n"  (llvm_int 64);
  b0 <- llvm_fresh_var "b0" (llvm_int 8);
  op <- llvm_fresh_var "op" (llvm_int 8);
  llvm_precond {{ op <= 0x4e }};
  llvm_execute_func [llvm_term n, llvm_term b0, llvm_term op];
  llvm_return (llvm_term {{ packed n b0 op }});
};
llvm_verify mC "cell_minpush" [] false spec abc;
llvm_verify mL "cell_minpush" [] false spec abc;
print "CELL_PUSH_MINPUSH_SAW_GREEN";
