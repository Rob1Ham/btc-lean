import "cell.cry";
mC <- llvm_load_module "c_cell_p2sh.bc";
mL <- llvm_load_module "l_cell_p2sh.bc";

// Symbolic in the three bytes the rule reads and in the script size: all
// 2^24 byte triples and all 2^32 sizes.
let spec = do {
  b0 <- llvm_fresh_var "b0" (llvm_int 8);
  b1 <- llvm_fresh_var "b1" (llvm_int 8);
  b22 <- llvm_fresh_var "b22" (llvm_int 8);
  n <- llvm_fresh_var "n" (llvm_int 32);
  llvm_execute_func [llvm_term b0, llvm_term b1, llvm_term b22, llvm_term n];
  llvm_return (llvm_term {{ packed b0 b1 b22 n }});
};
llvm_verify mC "cell_p2sh" [] false spec abc;
llvm_verify mL "cell_p2sh" [] false spec abc;
print "CELL_W32_P2SH_SAW_GREEN";
