import "cell.cry";
mC <- llvm_load_module "c_cell_po0.bc";
mL <- llvm_load_module "l_cell_po0.bc";
mC1 <- llvm_load_module "c_cell_po1.bc";
mL1 <- llvm_load_module "l_cell_po1.bc";

// Empty script: no opcodes, push-only.
let spec0 = do {
  llvm_execute_func [];
  llvm_return (llvm_term {{ packed0 }});
};
llvm_verify mC "cell_po0" [] false spec0 abc;
llvm_verify mL "cell_po0" [] false spec0 abc;

// One-byte script: all 256 opcode bytes, including OP_RESERVED (0x50), the
// OP_16 (0x60) / OP_17 (0x61) boundary, and every truncated push form.
let spec1 = do {
  b <- llvm_fresh_var "b" (llvm_int 8);
  llvm_execute_func [llvm_term b];
  llvm_return (llvm_term {{ packed1 b }});
};
llvm_verify mC1 "cell_po1" [] false spec1 abc;
llvm_verify mL1 "cell_po1" [] false spec1 abc;
print "CELL_W32_PUSHONLY_SAW_GREEN";
