import "cell.cry";

// Symbolic in every call-site argument: five operand bytes and the operand
// length (three bits, 0..7) for each decoded operand, the MINIMALDATA flag,
// the stack depth, the transaction context (locktime / sequence / version),
// the opcode budget and the activation flags.  C and L are each checked
// against the same Cryptol model.
let cltv_spec = do {
  a <- llvm_fresh_var "a" (llvm_int 8);
  b <- llvm_fresh_var "b" (llvm_int 8);
  c <- llvm_fresh_var "c" (llvm_int 8);
  d <- llvm_fresh_var "d" (llvm_int 8);
  e <- llvm_fresh_var "e" (llvm_int 8);
  len <- llvm_fresh_var "len" (llvm_int 8);
  mf <- llvm_fresh_var "mf" (llvm_int 8);
  depth <- llvm_fresh_var "depth" (llvm_int 32);
  txlt <- llvm_fresh_var "txlt" (llvm_int 32);
  txseq <- llvm_fresh_var "txseq" (llvm_int 32);
  flag <- llvm_fresh_var "flag" (llvm_int 8);
  llvm_execute_func [llvm_term a, llvm_term b, llvm_term c, llvm_term d,
                     llvm_term e, llvm_term len, llvm_term mf,
                     llvm_term depth, llvm_term txlt, llvm_term txseq,
                     llvm_term flag];
  llvm_return (llvm_term {{ cltv a b c d e len mf depth txlt txseq flag }});
};

let csv_spec = do {
  a <- llvm_fresh_var "a" (llvm_int 8);
  b <- llvm_fresh_var "b" (llvm_int 8);
  c <- llvm_fresh_var "c" (llvm_int 8);
  d <- llvm_fresh_var "d" (llvm_int 8);
  e <- llvm_fresh_var "e" (llvm_int 8);
  len <- llvm_fresh_var "len" (llvm_int 8);
  mf <- llvm_fresh_var "mf" (llvm_int 8);
  depth <- llvm_fresh_var "depth" (llvm_int 32);
  txver <- llvm_fresh_var "txver" (llvm_int 32);
  txseq <- llvm_fresh_var "txseq" (llvm_int 32);
  flag <- llvm_fresh_var "flag" (llvm_int 8);
  llvm_execute_func [llvm_term a, llvm_term b, llvm_term c, llvm_term d,
                     llvm_term e, llvm_term len, llvm_term mf,
                     llvm_term depth, llvm_term txver, llvm_term txseq,
                     llvm_term flag];
  llvm_return (llvm_term {{ csv a b c d e len mf depth txver txseq flag }});
};

let cms_spec = do {
  k0 <- llvm_fresh_var "k0" (llvm_int 8);
  k1 <- llvm_fresh_var "k1" (llvm_int 8);
  k2 <- llvm_fresh_var "k2" (llvm_int 8);
  k3 <- llvm_fresh_var "k3" (llvm_int 8);
  k4 <- llvm_fresh_var "k4" (llvm_int 8);
  klen <- llvm_fresh_var "klen" (llvm_int 8);
  s0 <- llvm_fresh_var "s0" (llvm_int 8);
  s1 <- llvm_fresh_var "s1" (llvm_int 8);
  s2 <- llvm_fresh_var "s2" (llvm_int 8);
  s3 <- llvm_fresh_var "s3" (llvm_int 8);
  s4 <- llvm_fresh_var "s4" (llvm_int 8);
  slen <- llvm_fresh_var "slen" (llvm_int 8);
  mf <- llvm_fresh_var "mf" (llvm_int 8);
  depth <- llvm_fresh_var "depth" (llvm_int 32);
  opcount <- llvm_fresh_var "opcount" (llvm_int 32);
  llvm_execute_func [llvm_term k0, llvm_term k1, llvm_term k2, llvm_term k3,
                     llvm_term k4, llvm_term klen, llvm_term s0,
                     llvm_term s1, llvm_term s2, llvm_term s3, llvm_term s4,
                     llvm_term slen, llvm_term mf, llvm_term depth,
                     llvm_term opcount];
  llvm_return (llvm_term {{ cms k0 k1 k2 k3 k4 klen s0 s1 s2 s3 s4 slen
                            mf depth opcount }});
};

let checksigadd_spec = do {
  a <- llvm_fresh_var "a" (llvm_int 8);
  b <- llvm_fresh_var "b" (llvm_int 8);
  c <- llvm_fresh_var "c" (llvm_int 8);
  d <- llvm_fresh_var "d" (llvm_int 8);
  e <- llvm_fresh_var "e" (llvm_int 8);
  len <- llvm_fresh_var "len" (llvm_int 8);
  mf <- llvm_fresh_var "mf" (llvm_int 8);
  depth <- llvm_fresh_var "depth" (llvm_int 32);
  sigversion <- llvm_fresh_var "sigversion" (llvm_int 8);
  llvm_execute_func [llvm_term a, llvm_term b, llvm_term c, llvm_term d,
                     llvm_term e, llvm_term len, llvm_term mf,
                     llvm_term depth, llvm_term sigversion];
  llvm_return (llvm_term {{ checksigadd a b c d e len mf depth sigversion }});
};

mCcltv <- llvm_load_module "c_cell_cltv.bc";
mLcltv <- llvm_load_module "l_cell_cltv.bc";
llvm_verify mCcltv "cell_cltv" [] false cltv_spec z3;
llvm_verify mLcltv "cell_cltv" [] false cltv_spec z3;

mCcsv <- llvm_load_module "c_cell_csv.bc";
mLcsv <- llvm_load_module "l_cell_csv.bc";
llvm_verify mCcsv "cell_csv" [] false csv_spec z3;
llvm_verify mLcsv "cell_csv" [] false csv_spec z3;

mCcms <- llvm_load_module "c_cell_cms.bc";
mLcms <- llvm_load_module "l_cell_cms.bc";
llvm_verify mCcms "cell_cms" [] false cms_spec z3;
llvm_verify mLcms "cell_cms" [] false cms_spec z3;

mCcsa <- llvm_load_module "c_cell_checksigadd.bc";
mLcsa <- llvm_load_module "l_cell_checksigadd.bc";
llvm_verify mCcsa "cell_checksigadd" [] false checksigadd_spec z3;
llvm_verify mLcsa "cell_checksigadd" [] false checksigadd_spec z3;

print "CELL_W32_NUM_CALLSITES_SAW_GREEN";
