module CellHashWidths where

// Concrete witnesses for the hash opcodes.  Every digest below was computed
// with Python hashlib (sha256; ripemd160 via OpenSSL) and is recorded in
// notes.md.  They are supplied to SAW as the opaque external returns; they
// are witnesses, not a proof of the hash implementations.

// Packed observable shared with src/hash_common.h h_pack:
//   result=1 | error=0 | depth=1 | length=len at bit 11 |
//   first five digest bytes at bits 24..63.
pack5 : [8] -> [8] -> [8] -> [8] -> [8] -> [8] -> [64]
pack5 len b0 b1 b2 b3 b4 =
      (0x0000000000000101 : [64])                       // result=1, depth=1
    + (zext len << 11)                     // element length
    + (zext b0 << 24)
    + (zext b1 << 32)
    + (zext b2 << 40)
    + (zext b3 << 48)
    + (zext b4 << 56)

// RIPEMD160("")   = 9c1185a5c5e9fc54612808977ee8f548b2258d31
exp_r160_e = pack5 20 0x9c 0x11 0x85 0xa5 0xc5
// RIPEMD160("a")  = 0bdc9d2d256b3ee9daae347be6f4dc835a467ffe
exp_r160_a = pack5 20 0x0b 0xdc 0x9d 0x2d 0x25

// SHA256("")      = e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
exp_s256_e = pack5 32 0xe3 0xb0 0xc4 0x42 0x98
// SHA256("a")     = ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb
exp_s256_a = pack5 32 0xca 0x97 0x81 0x12 0xca

// HASH160("")     = b472a266d0bd89c13706a4132ccfb16f7c3b9fcb
exp_h160_e = pack5 20 0xb4 0x72 0xa2 0x66 0xd0
// HASH160("a")    = 994355199e516ff76c4fa4aab39337b9d84cf12b
exp_h160_a = pack5 20 0x99 0x43 0x55 0x19 0x9e

// HASH256("")     = 5df6e0e2761359d30a8275058e299fcc0381534545f55cf43e41983f5d4c9456
exp_h256_e = pack5 32 0x5d 0xf6 0xe0 0xe2 0x76
// HASH256("a")    = bf5d3affb73efd2ec6c36ad3112dd933efed63c4e1cbffcfa88e2759c144f2d8
exp_h256_a = pack5 32 0xbf 0x5d 0x3a 0xff 0xb7

// Full digests, used by the SAW overrides.  Each primitive returns exactly
// these bytes for the closed preimage named by the override.
d_r160_e : [20][8]
d_r160_e = [0x9c, 0x11, 0x85, 0xa5, 0xc5, 0xe9, 0xfc, 0x54, 0x61, 0x28,
            0x08, 0x97, 0x7e, 0xe8, 0xf5, 0x48, 0xb2, 0x25, 0x8d, 0x31]
d_r160_a : [20][8]
d_r160_a = [0x0b, 0xdc, 0x9d, 0x2d, 0x25, 0x6b, 0x3e, 0xe9, 0xda, 0xae,
            0x34, 0x7b, 0xe6, 0xf4, 0xdc, 0x83, 0x5a, 0x46, 0x7f, 0xfe]
d_s256_e : [32][8]
