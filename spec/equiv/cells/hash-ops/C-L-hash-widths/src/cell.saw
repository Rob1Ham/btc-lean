import "cell.cry";

mC <- llvm_load_module "c_leaf.bc";
mL <- llvm_load_module "l_leaf.bc";

// Opaque hash externals, pinned to the closed preimage each exported function
// uses.  The digest is a concrete witness; the transform itself is not
// modelled (same-hash premise).
let ov_r160_e : LLVMSetup () = do {
  in_p  <- llvm_alloc (llvm_array 1 (llvm_int 8));
  llvm_points_to in_p (llvm_term {{ [0x00] : [1][8] }});
  out_p <- llvm_alloc (llvm_array 20 (llvm_int 8));
  llvm_execute_func [in_p, llvm_term {{ 0 : [32] }}, out_p];
  llvm_points_to out_p (llvm_term {{ d_r160_e }});
};
let ov_r160_a : LLVMSetup () = do {
  in_p  <- llvm_alloc (llvm_array 1 (llvm_int 8));
  llvm_points_to in_p (llvm_term {{ [0x61] : [1][8] }});
  out_p <- llvm_alloc (llvm_array 20 (llvm_int 8));
  llvm_execute_func [in_p, llvm_term {{ 1 : [32] }}, out_p];
  llvm_points_to out_p (llvm_term {{ d_r160_a }});
};
let ov_s256_e : LLVMSetup () = do {
  in_p  <- llvm_alloc (llvm_array 1 (llvm_int 8));
  llvm_points_to in_p (llvm_term {{ [0x00] : [1][8] }});
  out_p <- llvm_alloc (llvm_array 32 (llvm_int 8));
  llvm_execute_func [in_p, llvm_term {{ 0 : [32] }}, out_p];
  llvm_points_to out_p (llvm_term {{ d_s256_e }});
};
let ov_s256_a : LLVMSetup () = do {
  in_p  <- llvm_alloc (llvm_array 1 (llvm_int 8));
  llvm_points_to in_p (llvm_term {{ [0x61] : [1][8] }});
  out_p <- llvm_alloc (llvm_array 32 (llvm_int 8));
  llvm_execute_func [in_p, llvm_term {{ 1 : [32] }}, out_p];
  llvm_points_to out_p (llvm_term {{ d_s256_a }});
};
let ov_h160_e : LLVMSetup () = do {
  in_p  <- llvm_alloc (llvm_array 1 (llvm_int 8));
  llvm_points_to in_p (llvm_term {{ [0x00] : [1][8] }});
  out_p <- llvm_alloc (llvm_array 20 (llvm_int 8));
  llvm_execute_func [in_p, llvm_term {{ 0 : [32] }}, out_p];
  llvm_points_to out_p (llvm_term {{ d_h160_e }});
};
let ov_h160_a : LLVMSetup () = do {
  in_p  <- llvm_alloc (llvm_array 1 (llvm_int 8));
  llvm_points_to in_p (llvm_term {{ [0x61] : [1][8] }});
  out_p <- llvm_alloc (llvm_array 20 (llvm_int 8));
  llvm_execute_func [in_p, llvm_term {{ 1 : [32] }}, out_p];
  llvm_points_to out_p (llvm_term {{ d_h160_a }});
};
let ov_h256_e : LLVMSetup () = do {
  in_p  <- llvm_alloc (llvm_array 1 (llvm_int 8));
  llvm_points_to in_p (llvm_term {{ [0x00] : [1][8] }});
  out_p <- llvm_alloc (llvm_array 32 (llvm_int 8));
  llvm_execute_func [in_p, llvm_term {{ 0 : [32] }}, out_p];
  llvm_points_to out_p (llvm_term {{ d_h256_e }});
};
let ov_h256_a : LLVMSetup () = do {
  in_p  <- llvm_alloc (llvm_array 1 (llvm_int 8));
  llvm_points_to in_p (llvm_term {{ [0x61] : [1][8] }});
  out_p <- llvm_alloc (llvm_array 32 (llvm_int 8));
  llvm_execute_func [in_p, llvm_term {{ 1 : [32] }}, out_p];
  llvm_points_to out_p (llvm_term {{ d_h256_a }});
};

let ret (v : Term) : LLVMSetup () = do {
  llvm_execute_func [];
  llvm_return (llvm_term v);
};

// ---- C leg -------------------------------------------------------------
rC <- llvm_unsafe_assume_spec mC "ripemd160" ov_r160_e;
llvm_verify mC "cell_ripemd160_empty" [rC] false (ret {{ exp_r160_e }}) abc;
sC <- llvm_unsafe_assume_spec mC "sha256" ov_s256_e;
llvm_verify mC "cell_sha256_empty" [sC] false (ret {{ exp_s256_e }}) abc;
hC <- llvm_unsafe_assume_spec mC "hash160" ov_h160_e;
llvm_verify mC "cell_hash160_empty" [hC] false (ret {{ exp_h160_e }}) abc;
dC <- llvm_unsafe_assume_spec mC "hash256" ov_h256_e;
llvm_verify mC "cell_hash256_empty" [dC] false (ret {{ exp_h256_e }}) abc;

rCa <- llvm_unsafe_assume_spec mC "ripemd160" ov_r160_a;
llvm_verify mC "cell_ripemd160_a" [rCa] false (ret {{ exp_r160_a }}) abc;
sCa <- llvm_unsafe_assume_spec mC "sha256" ov_s256_a;
llvm_verify mC "cell_sha256_a" [sCa] false (ret {{ exp_s256_a }}) abc;
hCa <- llvm_unsafe_assume_spec mC "hash160" ov_h160_a;
llvm_verify mC "cell_hash160_a" [hCa] false (ret {{ exp_h160_a }}) abc;
dCa <- llvm_unsafe_assume_spec mC "hash256" ov_h256_a;
llvm_verify mC "cell_hash256_a" [dCa] false (ret {{ exp_h256_a }}) abc;

// ---- L leg -------------------------------------------------------------
rL <- llvm_unsafe_assume_spec mL "ripemd160" ov_r160_e;
llvm_verify mL "cell_ripemd160_empty" [rL] false (ret {{ exp_r160_e }}) abc;
sL <- llvm_unsafe_assume_spec mL "sha256" ov_s256_e;
llvm_verify mL "cell_sha256_empty" [sL] false (ret {{ exp_s256_e }}) abc;
hL <- llvm_unsafe_assume_spec mL "hash160" ov_h160_e;
llvm_verify mL "cell_hash160_empty" [hL] false (ret {{ exp_h160_e }}) abc;
dL <- llvm_unsafe_assume_spec mL "hash256" ov_h256_e;
llvm_verify mL "cell_hash256_empty" [dL] false (ret {{ exp_h256_e }}) abc;

rLa <- llvm_unsafe_assume_spec mL "ripemd160" ov_r160_a;
llvm_verify mL "cell_ripemd160_a" [rLa] false (ret {{ exp_r160_a }}) abc;
sLa <- llvm_unsafe_assume_spec mL "sha256" ov_s256_a;
llvm_verify mL "cell_sha256_a" [sLa] false (ret {{ exp_s256_a }}) abc;
hLa <- llvm_unsafe_assume_spec mL "hash160" ov_h160_a;
llvm_verify mL "cell_hash160_a" [hLa] false (ret {{ exp_h160_a }}) abc;
dLa <- llvm_unsafe_assume_spec mL "hash256" ov_h256_a;
llvm_verify mL "cell_hash256_a" [dLa] false (ret {{ exp_h256_a }}) abc;

print "CELL_HASH_WIDTHS_SAW_GREEN";
