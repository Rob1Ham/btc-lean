/-! ## 3. `GetSizeOfCompactSize` (serialize.h:291-297) -/

/-- The pinned if-chain: 1 byte for n < 253, 3 for n <= 0xffff, 5 for
n <= 0xffffffff, else 9. -/
def csSize (n : Nat) : Nat :=
  if n < 253 then 1
  else if n ≤ 0xffff then 3
  else if n ≤ 0xffffffff then 5
  else 9

/-- `csSize` is the length of the model's canonical CompactSize encoder, so the
SAW-verified C function (`cell_compact_size_size`) and the Lean `compactSizeEnc`
agree through the same function. -/
theorem csSize_eq_compactSizeEnc (n : Nat) : csSize n = (compactSizeEnc n).size := by
  unfold csSize compactSizeEnc
  by_cases h1 : n < 0xfd <;> by_cases h2 : n ≤ 0xffff <;>
    by_cases h3 : n ≤ 0xffffffff <;>
    simp [h1, h2, h3, serU8, serU16, serU32, serU64, ByteArray.size_push,
      ByteArray.size_append]

/-- The 9-byte branch is exactly `n > 0xffffffff` (the same lemma SAW proves as
`lemma_cs_size_9byte_iff_gt_0xffffffff`). -/
theorem csSize_eq_nine_iff (n : Nat) : csSize n = 9 ↔ 0xffffffff < n := by
  unfold csSize
  by_cases h1 : n < 253 <;> by_cases h2 : n ≤ 0xffff <;>
    by_cases h3 : n ≤ 0xffffffff <;> simp [h1, h2, h3] <;> omega

/-! ## 4. Fragment ASTs and their pretty-printers

Two statement layers, one per pinned construct:

* `IEff` — the element serializer (`Serialize(SizeComputer&, vector<u8>)`,
  serialize.h:900-902), whose stream variable is `os` and vector is `v`;
* `OEff` — `VectorFormatter::Ser` (serialize.h:671-675), whose stream is `s`
  and vector is `v`, and whose loop body is one call of the element
  serializer.

`renderI` / `renderO` print an AST back to the canonical single-line form; the
kernel then checks that the pretty-printed AST equals the pinned text modulo
whitespace.  That is the (machine-checked) extraction step. -/

/-- Element-serializer statements. -/
inductive IEff where
  | addCS     -- WriteCompactSize(os, v.size());
  | ifBytes   -- if (!v.empty()) os.write(MakeByteSpan(v));
  deriving DecidableEq, Repr

/-- `VectorFormatter::Ser` statements. -/
inductive OEff where
  | declare    -- Formatter formatter;
  | addCSOuter -- WriteCompactSize(s, v.size());
  | forEachElem -- for (const V::value_type& elem : v) formatter.Ser(s, elem);
  deriving DecidableEq, Repr

/-- Pretty-print an element-serializer AST (`os`, `v` are the pinned names). -/
def renderI : List IEff → String
  | [] => ""
  | .addCS :: r => "WriteCompactSize(os, v.size());" ++ renderI r
  | .ifBytes :: r => "if (!v.empty()) os.write(MakeByteSpan(v));" ++ renderI r

/-- Pretty-print a `VectorFormatter::Ser` AST (`s`, `v` are the pinned names). -/
def renderO : List OEff → String
  | [] => ""
  | .declare :: r => "Formatter formatter;" ++ renderO r
  | .addCSOuter :: r => "WriteCompactSize(s, v.size());" ++ renderO r
  | .forEachElem :: r =>
      "for (const typename V::value_type& elem : v) { formatter.Ser(s, elem); }" ++ renderO r

/-- The element serializer's body, in pinned order. -/
def innerProg : List IEff := [.addCS, .ifBytes]

/-- `VectorFormatter::Ser`'s body, in pinned order. -/
def vecSerProg : List OEff := [.declare, .addCSOuter, .forEachElem]

/-! ## 5. Semantics of the fragment

`runI` is the effect of the element serializer on a `SizeComputer`: it adds
exactly the bytes Core's `seek`/`write` add.  `runO` is the outer serializer;
its `forEachElem` statement runs the element serializer on every element, in
order, from index 0.  `runLoopF` is the operational loop: explicit index, the
`i < size` guard, one element per iteration, index increment. -/

/-- Element-serializer effect: `acc` is the SizeComputer byte count. -/
def runI : List IEff → ByteArray → Nat → Nat
  | [], _, acc => acc
  | .addCS :: r, d, acc => runI r d (acc + csSize d.size)
  | .ifBytes :: r, d, acc => runI r d (acc + if d.isEmpty then 0 else d.size)

/-- One element's contribution: CompactSize(len) + len. -/
def innerStep (acc : Nat) (d : ByteArray) : Nat :=
  acc + (csSize d.size + d.size)

/-- The same, from a zero accumulator (the fold's step). -/
def innerStep0 (d : ByteArray) : Nat := csSize d.size + d.size

/-- `Int.ofNat` is the `Nat.cast` instance for `Int`; this is the exact
syntactic form the fold lemmas need (the core `Int.natCast_add` is stated in
the opposite direction and does not match `Int.ofNat` syntactically). -/
theorem ofNat_add_ofNat (a b : Nat) :
    (Int.ofNat a + Int.ofNat b : Int) = Int.ofNat (a + b) := rfl

/-- The loop model: `f` is the compiled loop body, `i` the iterator index,
`n` the remaining fuel.  Each iteration checks `i < v.size()`, applies the body
to `v[i]` and increments the index — the control structure of
`VectorFormatter::Ser`'s range-for, not a fold. -/
def runLoopF (f : Nat → ByteArray → Nat) (items : List ByteArray) :
    Nat → Nat → Nat → Nat
  | 0, acc, _ => acc
  | n + 1, acc, i =>
      if h : i < items.length then
        runLoopF f items n (f acc items[i]) (i + 1)
      else acc

/-- The loop as executed from the beginning, with fuel `|items| + 1` (one
iteration per element plus the terminating guard check). -/
def runLoop (f : Nat → ByteArray → Nat) (items : List ByteArray) (acc : Nat) : Nat :=
  runLoopF f items (items.length + 1) acc 0

/-- Outer serializer effect.  `inner` is the element serializer's program (the
loop body), supplied once so the `forEachElem` statement is the real call. -/
def runO (inner : List IEff) : List OEff → List ByteArray → Nat → Nat
  | [], _, acc => acc
  | .declare :: r, items, acc => runO inner r items acc
  | .addCSOuter :: r, items, acc => runO inner r items (acc + csSize items.length)
  | .forEachElem :: r, items, acc =>
      runO inner r items (runLoop (fun a d => runI inner d a) items acc)

/-! ## 6. Per-element step lemmas -/

/-- The `if (!v.empty())` guard: writing a byte span adds its length; the empty
span adds 0, which is its length.  So the guarded write is exactly `len`. -/
theorem if_empty_size (d : ByteArray) :
    (if d.isEmpty then 0 else d.size) = d.size := by
  by_cases h : d.isEmpty
  · have hz : d.size = 0 := by simpa [ByteArray.isEmpty] using h
    simp [h, hz]
  · simp [h]

/-- The element serializer adds `CompactSize(len)` then the guarded payload. -/
theorem runI_innerProg (d : ByteArray) (acc : Nat) :
    runI innerProg d acc = acc + (csSize d.size + d.size) := by
  simp [innerProg, runI, if_empty_size, Nat.add_assoc]

/-- Hence the element serializer is exactly the fold step. -/
theorem runI_innerProg_eq_innerStep (d : ByteArray) (acc : Nat) :
    runI innerProg d acc = innerStep acc d := by
  rw [runI_innerProg]
  rfl

/-! ## 7. The loop-to-fold bridge, arbitrary item count -/

/-- A left fold that adds a per-element quantity distributes over the seed. -/
theorem foldl_add (g : ByteArray → Nat) (xs : List ByteArray) (acc : Nat) :
    xs.foldl (fun a d => a + g d) acc = acc + xs.foldl (fun a d => a + g d) 0 := by
  induction xs generalizing acc with
  | nil => simp
  | cons d r ih =>
      simp only [List.foldl_cons, Nat.zero_add]
      rw [ih (acc + g d), ih (g d)]
      omega

/-- **The bridge.**  The operational loop (index + guard + increment, fuel
`n`) from index `i` reaches the left fold of the per-element effect over the
remaining elements, for an arbitrary list and any fuel that covers the
remaining length.  `f` is any loop body that adds a per-element quantity
`g` to the accumulator. -/
theorem runLoopF_eq_fold (f : Nat → ByteArray → Nat) (g : ByteArray → Nat)
    (hfg : ∀ a d, f a d = a + g d) (items : List ByteArray) :
    ∀ (n acc i : Nat), i ≤ items.length → items.length ≤ i + n →
      runLoopF f items n acc i =
        acc + (items.drop i).foldl (fun a d => a + g d) 0 := by
  intro n
  induction n with
  | zero =>
      intro acc i hi hlen
      have heq : i = items.length := by omega
      subst heq
      simp [runLoopF, List.drop_length]
  | succ n ih =>
      intro acc i hi hlen
      by_cases h : i < items.length
      · have hstep : runLoopF f items (n + 1) acc i =
            runLoopF f items n (f acc items[i]) (i + 1) := by
          simp only [runLoopF, dite_eq_left h]
        rw [hstep]
        have h1 : i + 1 ≤ items.length := h
        have h2 : items.length ≤ i + 1 + n := by omega
        rw [ih (f acc items[i]) (i + 1) h1 h2, hfg]
        have hd : items.drop i = items[i] :: items.drop (i + 1) :=
          List.drop_eq_getElem_cons (l := items) (i := i) h
        rw [hd]
        simp only [List.foldl_cons, Nat.zero_add]
        rw [foldl_add g (items.drop (i + 1)) (g items[i])]
        omega
      · have heq : i = items.length := by omega
        subst heq
        simp [runLoopF, List.drop_length]

/-- **SCR-040, arbitrary count.**  The element loop from the start accumulates
exactly the fold of the per-element step over the whole stack.  No arity
hypothesis, no item-length hypothesis. -/
theorem runLoop_eq_fold (items : List ByteArray) (acc : Nat) :
    runLoop innerStep items acc = acc + items.foldl innerStep 0 := by
  unfold runLoop
  have h := runLoopF_eq_fold innerStep innerStep0
    (fun a d => rfl) items (items.length + 1) acc 0 (by omega) (by omega)
  have hstep : (fun a d => a + innerStep0 d) = innerStep := by
    funext a d
    rfl
  rw [hstep, List.drop_zero] at h
  exact h

/-! ## 8. The outer serializer and the seed -/

/-- `VectorFormatter::Ser` over the pinned AST: count prefix, then the element
loop. -/
theorem runO_vecSerProg (items : List ByteArray) :
    runO innerProg vecSerProg items 0 =
      csSize items.length + items.foldl innerStep 0 := by
  have hf : (fun a d => runI innerProg d a) = innerStep := by
    funext a d
    exact runI_innerProg_eq_innerStep d a
  simp only [vecSerProg, runO, hf, runLoop_eq_fold]
  simp [Nat.zero_add]

/-- `VALIDATION_WEIGHT_OFFSET{50}` parsed from the pinned script.h line. -/
def parsedOffset : Nat := 50

/-- The seed expression of interpreter.cpp:1991-1992: the serialized witness
stack (SizeComputer starts empty) plus the offset. -/
def seedValue (items : List ByteArray) : Nat :=
  runO innerProg vecSerProg items 0 + parsedOffset

/-- The seed in explicit form: CompactSize(count) + sum(CompactSize(len)+len)
+ 50. -/
theorem seedValue_eq_count_add_fold (items : List ByteArray) :
    seedValue items = csSize items.length + items.foldl innerStep 0 + parsedOffset := by
  unfold seedValue parsedOffset
  rw [runO_vecSerProg]

/-- The model's payload fold, restated at the Nat level used by the loop. -/
theorem witnessPayloadSize_eq_natFold (items : List ByteArray) :
    witnessPayloadSize items =
      Int.ofNat (items.foldl (fun a d => a + (csSize d.size + d.size)) 0) := by
  unfold witnessPayloadSize
  have key : ∀ (r : List ByteArray) (seed : Nat),
      r.foldl (fun acc d => acc + Int.ofNat ((compactSizeEnc d.size).size + d.size))
          (Int.ofNat seed) =
        Int.ofNat (r.foldl (fun a d => a + (csSize d.size + d.size)) seed) := by
    intro r
    induction r with
    | nil => intro seed; simp
    | cons d r ih =>
        intro seed
        simp only [List.foldl_cons]
        rw [csSize_eq_compactSizeEnc, ofNat_add_ofNat]
        exact ih _
  simpa using key items 0

/-- The live model's `witnessSerSize` is exactly the loop's byte count. -/
theorem witnessSerSize_eq_loop (items : List ByteArray) :
    witnessSerSize items =
      Int.ofNat (csSize items.length + items.foldl innerStep 0) := by
  unfold witnessSerSize
  rw [witnessPayloadSize_eq_natFold, csSize_eq_compactSizeEnc, ofNat_add_ofNat]
  rfl

/-- **SCR-040 seed, arbitrary count.**  The value computed by the pinned seed
expression (count prefix + element loop + the parsed 50) is exactly the live
btc-lean model's `validationWeightInit`, for an arbitrary witness stack. -/
theorem seed_eq_validationWeightInit (items : List ByteArray) :
    (seedValue items : Int) = validationWeightInit items := by
  rw [seedValue_eq_count_add_fold]
  unfold validationWeightInit VALIDATION_WEIGHT_OFFSET
  rw [witnessSerSize_eq_loop]
  have hoff : parsedOffset = 50 := rfl
  rw [hoff, ← ofNat_add_ofNat]
  rfl

/-! ## 9. The pinned-text checks (kernel `decide`)

Each `pinned_*` fact is checked by the kernel: the embedded literal from
`src/extract_pinned.py` is the pinned Core text (script hashes are recorded in
`lean/result.txt`), and the pretty-printed AST is character-identical modulo
whitespace.  If Core's text at the pin changes, these stop compiling. -/

/-- `serialize.h:1129` — `SizeComputer::seek` adds the byte count. -/
theorem pinned_sizecomputer_seek :
    sameCode exSizeComputerSeek "m_size += num;" = true := by decide

/-- `serialize.h:1123` — `SizeComputer::write` adds the span length. -/
theorem pinned_sizecomputer_write :
    sameCode exSizeComputerWrite "m_size += src.size();" = true := by decide

/-- `serialize.h:1153` — `WriteCompactSize(SizeComputer&, n)` seeks
`GetSizeOfCompactSize(n)`. -/
theorem pinned_write_compact_size :
    sameCode exWriteCompactSize "s.seek(GetSizeOfCompactSize(nSize));" = true := by decide

/-- `serialize.h:1159` — `GetSerializeSize(t) = (SizeComputer() << t).size()`. -/
theorem pinned_get_serialize_size :
    sameCode exGetSerializeSize "return (SizeComputer() << t).size();" = true := by decide

/-- `serialize.h:671-675` — the element loop, printed from `vecSerProg`. -/
theorem pinned_vector_ser :
    sameCode exVectorFormatterSer (renderO vecSerProg) = true := by decide

/-- `serialize.h:901-902` — the element serializer body, printed from
`innerProg`. -/
theorem pinned_basic_byte :
    sameCode exBasicByteSerialize (renderI innerProg) = true := by decide

/-- `script.h:65` — `VALIDATION_WEIGHT_OFFSET{50}`; the literal is rebuilt from
`parsedOffset`, so a different constant fails here. -/
theorem pinned_offset :
    sameCode exValidationWeightOffset
      ("inline constexpr int64_t VALIDATION_WEIGHT_OFFSET{" ++
        toString parsedOffset ++ "};") = true := by decide

/-- `interpreter.cpp:1991` — the seed assignment line. -/
theorem pinned_seed_line :
    sameCode exValidationWeightSeed
      "execdata.m_validation_weight_left = ::GetSerializeSize(witness.stack) + \
       VALIDATION_WEIGHT_OFFSET;" = true := by decide

-- Axiom audit: the kernel axioms only, no `sorry`, no `native_decide`.
#print axioms runLoop_eq_fold
#print axioms seed_eq_validationWeightInit
