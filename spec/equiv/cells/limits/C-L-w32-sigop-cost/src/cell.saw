// SAW proof of the weight-unit aggregation against cell.cry.  Both legs
// expose cell_sigop_cost(legacy, p2sh, witness, coinbase, p2sh_flag); the
// contract is symbolic over all five 32-bit arguments.
import "cell.cry";

mC <- llvm_load_module "c_cell_sigop_cost.bc";
mL <- llvm_load_module "l_cell_sigop_cost.bc";

let spec = do {
  legacy <- llvm_fresh_var "legacy" (llvm_int 32);
  p2sh <- llvm_fresh_var "p2sh" (llvm_int 32);
  witness <- llvm_fresh_var "witness" (llvm_int 32);
  coinbase <- llvm_fresh_var "coinbase" (llvm_int 32);
  p2shFlag <- llvm_fresh_var "p2shFlag" (llvm_int 32);
  llvm_execute_func [llvm_term legacy, llvm_term p2sh, llvm_term witness,
                     llvm_term coinbase, llvm_term p2shFlag];
  llvm_return (llvm_term {{ cost legacy p2sh witness coinbase p2shFlag }});
};

llvm_verify mC "cell_sigop_cost" [] false spec abc;
llvm_verify mL "cell_sigop_cost" [] false spec abc;

print "CELL_W32_SIGOP_COST_SAW_GREEN";
