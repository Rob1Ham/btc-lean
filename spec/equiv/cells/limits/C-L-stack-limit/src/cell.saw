import "cell.cry";
// functions: cell_stack_limit
mC <- llvm_load_module "c_cell_stack_limit.bc";
mL <- llvm_load_module "l_cell_stack_limit.bc";

// Both legs are verified against the same independent Cryptol predicate for
// every pair of bounded main/altstack depths (the full 32-bit input width;
// the domain guard handles values above 2000 identically on both legs).
let spec = do {
  depth <- llvm_fresh_var "depth" (llvm_int 32);
  alt   <- llvm_fresh_var "alt"   (llvm_int 32);
  llvm_execute_func [llvm_term depth, llvm_term alt];
  llvm_return (llvm_term {{ stack_limit_spec depth alt }});
};
llvm_verify mC "cell_stack_limit" [] false spec abc;
llvm_verify mL "cell_stack_limit" [] false spec abc;
print "CELL_LIMITS_STACK_LIMIT_SAW_GREEN";
