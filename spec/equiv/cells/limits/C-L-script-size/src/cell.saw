import "cell.cry";
// functions: cell_script_size
mC <- llvm_load_module "c_cell_script_size.bc";
mL <- llvm_load_module "l_cell_script_size.bc";

// Both legs are verified against the same independent Cryptol predicate for
// every 64-bit script length and every sigversion byte.
let spec = do {
  len <- llvm_fresh_var "len" (llvm_int 64);
  sv  <- llvm_fresh_var "sv"  (llvm_int 8);
  llvm_execute_func [llvm_term len, llvm_term sv];
  llvm_return (llvm_term {{ script_size_spec len sv }});
};
llvm_verify mC "cell_script_size" [] false spec abc;
llvm_verify mL "cell_script_size" [] false spec abc;
print "CELL_LIMITS_SCRIPT_SIZE_SAW_GREEN";
