module CellWitnessSigopDispatch where

// Independent specification of WitnessSigOps (Core interpreter.cpp:2133-2147,
// Lean Interpreter/SigOps.lean witnessSigOps).
//
//   version = 0, program length 20              -> 1
//   version = 0, program length 32, last exists -> accurate count of last item
//   version = 0, program length 32, empty       -> 0
//   version = 0, other program length           -> 0
//   version /= 0 (v1+, taproot)                 -> 0
//
// `has_last` is `witness.stack.size() > 0`; `last` is the accurate
// GetSigOpCount(true) of witness.stack.back(), proved separately.
witness_sigops : [8] -> [32] -> [8] -> [32] -> [32]
witness_sigops version plen has_last last =
  if version == 0 then
    if plen == 20 then 1
    else if plen == 32 then
      if has_last != 0 then last else 0
    else 0
  else 0
