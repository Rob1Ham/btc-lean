import "cell.cry";
mC <- llvm_load_module "c_cell_witness_sigops.bc";
mL <- llvm_load_module "l_cell_witness_sigops.bc";

// Version/program-length dispatch and count selection for every 8-bit
// witness version, every 32-bit program length, both witness-empty states
// and every 32-bit accurate count of the last witness item.
let spec = do {
  ver  <- llvm_fresh_var "witversion" (llvm_int 8);
  plen <- llvm_fresh_var "program_len" (llvm_int 32);
  ne   <- llvm_fresh_var "witness_nonempty" (llvm_int 8);
  last <- llvm_fresh_var "last_item_sigops" (llvm_int 32);
  llvm_execute_func [llvm_term ver, llvm_term plen, llvm_term ne, llvm_term last];
  llvm_return (llvm_term {{ witness_sigops ver plen ne last }});
};
llvm_verify mC "cell_witness_sigops" [] false spec abc;
llvm_verify mL "cell_witness_sigops" [] false spec abc;
print "CELL_limits_witness_sigop_dispatch_SAW_GREEN";
