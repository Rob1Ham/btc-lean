import "cell.cry";
mCb <- llvm_load_module "c_cell_tapscript_budget.bc";
mLb <- llvm_load_module "l_cell_tapscript_budget.bc";
mCc <- llvm_load_module "c_cell_tapscript_checksig.bc";
mLc <- llvm_load_module "l_cell_tapscript_checksig.bc";

// Budget: all 32-bit item lengths and arities 0..4 (the cell's bound).
let budget_spec = do {
  ni <- llvm_fresh_var "n_items" (llvm_int 32);
  l0 <- llvm_fresh_var "len0" (llvm_int 32);
  l1 <- llvm_fresh_var "len1" (llvm_int 32);
  l2 <- llvm_fresh_var "len2" (llvm_int 32);
  l3 <- llvm_fresh_var "len3" (llvm_int 32);
  llvm_precond {{ ni <=$ 4 }};
  llvm_execute_func [llvm_term ni, llvm_term l0, llvm_term l1, llvm_term l2, llvm_term l3];
  llvm_return (llvm_term {{ budget ni l0 l1 l2 l3 }});
};
llvm_verify mCb "cell_tapscript_budget" [] false budget_spec abc;
llvm_verify mLb "cell_tapscript_budget" [] false budget_spec abc;

// Checksig accounting: every 32-bit-weight budget, empty/non-empty signature,
// the three pubkey-size classes, the discouragement flag and the checker bit.
let checksig_spec = do {
  w   <- llvm_fresh_var "w_in" (llvm_int 64);
  ne  <- llvm_fresh_var "sig_nonempty" (llvm_int 8);
  pk  <- llvm_fresh_var "pk_class" (llvm_int 8);
  dis <- llvm_fresh_var "discourage" (llvm_int 8);
  ok  <- llvm_fresh_var "checker_ok" (llvm_int 8);
  llvm_precond {{ (w >=$ -2147483648) && (w <=$ 2147483648) }};
  llvm_execute_func [llvm_term w, llvm_term ne, llvm_term pk, llvm_term dis, llvm_term ok];
  llvm_return (llvm_term {{ checksig w ne pk dis ok }});
};
llvm_verify mCc "cell_tapscript_checksig" [] false checksig_spec abc;
llvm_verify mLc "cell_tapscript_checksig" [] false checksig_spec abc;
print "CELL_limits_tapscript_weight_SAW_GREEN";
