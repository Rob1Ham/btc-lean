module CellTapscriptWeight where

// Independent specification of the BIP342 budget and checksig accounting.
//
// Budget (Core interpreter.cpp:1991-1992; Lean Defs.lean:1229 and
// Crypto/Taproot/Program.lean witnessSerSize):
//   CompactSize(stack arity) + sum_i (CompactSize(len_i) + len_i) + 50
// The arity is bounded to 4 items (the cell's four length arguments).
t253 : [64]
t253 = 0x00000000000000fd

t16 : [64]
t16 = 0x000000000000ffff

t32 : [64]
t32 = 0x00000000ffffffff

cs_size : [64] -> [64]
cs_size n = if n < t253 then 1
            else if n <= t16 then 3
            else if n <= t32 then 5
            else 9

budget : [32] -> [32] -> [32] -> [32] -> [32] -> [64]
budget ni l0 l1 l2 l3 =
  cs_size (zext ni)
  + (if ni > 0 then cs_size (zext l0) + zext l0 else 0)
  + (if ni > 1 then cs_size (zext l1) + zext l1 else 0)
  + (if ni > 2 then cs_size (zext l2) + zext l2 else 0)
  + (if ni > 3 then cs_size (zext l3) + zext l3 else 0)
  + 50

// Packed checksig observable:
//   decision(2) | error(6) << 2 | success(1) << 8 | low32(w_after) << 9
// decision: 1 = no script error, 0 = known script error ordinal,
//           2 = the Schnorr checker rejected (ordinal outside the cell).
low32 : [64] -> [32]
low32 x = drop x

pack_acc : [2] -> [6] -> [1] -> [64] -> [64]
pack_acc d e s w =
  (zext d) || (zext e << 2) || (zext s << 8) || (zext (low32 w) << 9)

// pk_class: 0 = pubkey.size()==0, 1 = ==32, 2 = any other (upgradable).
checksig : [64] -> [8] -> [8] -> [8] -> [8] -> [64]
checksig w_in sig_ne pk_class discourage checker_ok =
  if sig_ne != 0 then
    if (w_in - 50) <$ 0 then pack_acc 0 49 1 (w_in - 50)
    else if pk_class == 0 then pack_acc 0 52 1 (w_in - 50)
    else if pk_class == 1 then
      if checker_ok == 0 then pack_acc 2 0 1 (w_in - 50)
      else pack_acc 1 0 1 (w_in - 50)
    else if discourage != 0 then pack_acc 0 37 1 (w_in - 50)
    else pack_acc 1 0 1 (w_in - 50)
  else
    if pk_class == 0 then pack_acc 0 52 0 w_in
    else if pk_class == 1 then pack_acc 1 0 0 w_in
    else if discourage != 0 then pack_acc 0 37 0 w_in
    else pack_acc 1 0 0 w_in
