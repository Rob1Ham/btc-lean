import "cell.cry";
mC <- llvm_load_module "c_cell_cms_count_bounds.bc";
mL <- llvm_load_module "l_cell_cms_count_bounds.bc";

// The three OP_CHECKMULTISIG bound checks, verified against the independent
// Cryptol predicate for every signed 32-bit (nKeysCount, nSigsCount) and
// every in-range nOpCount (0..201).  The precondition is Core's EvalScript
// op-counter invariant: the per-opcode check at interpreter.cpp:459-463
// leaves nOpCount at most 201 on entry to any opcode.
let spec = do {
  keys <- llvm_fresh_var "nKeysCount" (llvm_int 32);
  sigs <- llvm_fresh_var "nSigsCount" (llvm_int 32);
  ops  <- llvm_fresh_var "nOpCount" (llvm_int 32);
  llvm_precond {{ (0 <=$ ops) && (ops <=$ 201) }};
  llvm_execute_func [llvm_term keys, llvm_term sigs, llvm_term ops];
  llvm_return (llvm_term {{ cms_count_bounds keys sigs ops }});
};
llvm_verify mC "cell_cms_count_bounds" [] false spec abc;
llvm_verify mL "cell_cms_count_bounds" [] false spec abc;
print "CELL_limits_cms_count_bounds_SAW_GREEN";
