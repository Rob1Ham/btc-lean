module CellCmsCountBounds where

// Independent specification of the three OP_CHECKMULTISIG limit checks.
//
// Source: Bitcoin Core interpreter.cpp:1127-1142 at pin cce32b168:
//   nKeysCount < 0 || nKeysCount > 20                    -> PUBKEY_COUNT(10)
//   nOpCount += nKeysCount; nOpCount > 201               -> OP_COUNT(7)
//   nSigsCount < 0 || nSigsCount > nKeysCount            -> SIG_COUNT(9)
// Lean twin: Interpreter/Defs.lean checkMultiSig (same order, same bounds).
//
// Packed observable: result(2) | error(6) << 2 | nOpCount_after(32) << 8.
// All counters are signed 32-bit, matching Core's `int` locals.
pack : [2] -> [6] -> [32] -> [64]
pack r e x = (zext r) || (zext e << 2) || (zext x << 8)

cms_count_bounds : [32] -> [32] -> [32] -> [64]
cms_count_bounds keys sigs ops =
  if (keys <$ 0) || (keys >$ 20) then pack 0 10 ops
  else if (ops + keys) >$ 201 then pack 0 7 (ops + keys)
  else if (sigs <$ 0) || (sigs >$ keys) then pack 0 9 (ops + keys)
  else pack 1 0 (ops + keys)
