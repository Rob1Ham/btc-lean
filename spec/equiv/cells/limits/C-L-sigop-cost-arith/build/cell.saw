import "cell.cry";
mC <- llvm_load_module "c_cell_tx_sigop_cost.bc";
mL <- llvm_load_module "l_cell_tx_sigop_cost.bc";
mCg <- llvm_load_module "c_cell_block_sigop_gate.bc";
mLg <- llvm_load_module "l_cell_block_sigop_gate.bc";
mCp <- llvm_load_module "c_cell_tx_sigop_policy.bc";
mLp <- llvm_load_module "l_cell_tx_sigop_policy.bc";

// Cost aggregation: every 32-bit legacy/P2SH/witness count, every 0/1 flag
// state (the Core script flags and IsCoinBase are booleans; any non-zero byte
// follows the same branch in both legs).
let cost_spec = do {
  legacy <- llvm_fresh_var "legacy" (llvm_int 32);
  p2sh   <- llvm_fresh_var "p2sh" (llvm_int 32);
  wit    <- llvm_fresh_var "witness" (llvm_int 32);
  cb     <- llvm_fresh_var "coinbase" (llvm_int 8);
  pf     <- llvm_fresh_var "p2sh_flag" (llvm_int 8);
  wf     <- llvm_fresh_var "witness_flag" (llvm_int 8);
  llvm_execute_func [llvm_term legacy, llvm_term p2sh, llvm_term wit,
                     llvm_term cb, llvm_term pf, llvm_term wf];
  llvm_return (llvm_term {{ sigop_cost legacy p2sh wit cb pf wf }});
};
llvm_verify mC "cell_tx_sigop_cost" [] false cost_spec abc;
llvm_verify mL "cell_tx_sigop_cost" [] false cost_spec abc;

// The two caps: every signed 64-bit cumulative cost.
let gate_spec = do {
  c <- llvm_fresh_var "cumulative" (llvm_int 64);
  llvm_precond {{ (0 <=$ c) && (c <=$ 0x7fffffffffffffff) }};
  llvm_execute_func [llvm_term c];
  llvm_return (llvm_term {{ block_gate c }});
};
llvm_verify mCg "cell_block_sigop_gate" [] false gate_spec abc;
llvm_verify mLg "cell_block_sigop_gate" [] false gate_spec abc;

let pol_spec = do {
  c <- llvm_fresh_var "cost" (llvm_int 64);
  llvm_precond {{ (0 <=$ c) && (c <=$ 0x7fffffffffffffff) }};
  llvm_execute_func [llvm_term c];
  llvm_return (llvm_term {{ tx_policy c }});
};
llvm_verify mCp "cell_tx_sigop_policy" [] false pol_spec abc;
llvm_verify mLp "cell_tx_sigop_policy" [] false pol_spec abc;
print "CELL_limits_sigop_cost_arith_SAW_GREEN";
