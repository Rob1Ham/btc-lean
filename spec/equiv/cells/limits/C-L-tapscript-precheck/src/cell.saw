import "cell.cry";
// functions: cell_tap_precheck
mC <- llvm_load_module "c_cell_tap_precheck.bc";
mL <- llvm_load_module "l_cell_tap_precheck.bc";

// Both legs are verified against the same independent Cryptol predicate for
// every bounded depth, sigversion, OP_SUCCESSx/discourage bit, and opaque
// EvalScript error ordinal.
let spec = do {
  depth      <- llvm_fresh_var "depth"      (llvm_int 32);
  sv         <- llvm_fresh_var "sv"         (llvm_int 8);
  success    <- llvm_fresh_var "success"    (llvm_int 8);
  discourage <- llvm_fresh_var "discourage" (llvm_int 8);
  inner      <- llvm_fresh_var "inner"      (llvm_int 8);
  llvm_execute_func [llvm_term depth, llvm_term sv, llvm_term success,
                     llvm_term discourage, llvm_term inner];
  llvm_return (llvm_term {{ tap_precheck_spec depth sv success discourage inner }});
};
llvm_verify mC "cell_tap_precheck" [] false spec abc;
llvm_verify mL "cell_tap_precheck" [] false spec abc;
print "CELL_LIMITS_TAPSCRIPT_PRECHECK_SAW_GREEN";
