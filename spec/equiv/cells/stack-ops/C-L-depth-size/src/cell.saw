let specdepth_d0 = do {
  opc <- llvm_fresh_var "opc" (llvm_int 8);
  sv <- llvm_fresh_var "sv" (llvm_int 8);
  llvm_execute_func [llvm_term opc, llvm_term sv];
  llvm_return (llvm_term {{ d0 opc sv }});
};

