mskip <- llvm_load_module "c_cell_skip.bc";
lskip <- llvm_load_module "l_cell_skip.bc";

let specpick_d3_sym = do {
  e0 <- llvm_fresh_var "e0" (llvm_int 8);
  e1 <- llvm_fresh_var "e1" (llvm_int 8);
  e2 <- llvm_fresh_var "e2" (llvm_int 8);
  idx <- llvm_fresh_var "idx" (llvm_int 8);
  opc <- llvm_fresh_var "opc" (llvm_int 8);
  sv <- llvm_fresh_var "sv" (llvm_int 8);
  llvm_execute_func [llvm_term e0, llvm_term e1, llvm_term e2, llvm_term idx, llvm_term opc, llvm_term sv];
  llvm_return (llvm_term {{ p3 e0 e1 e2 idx opc sv }});
};

