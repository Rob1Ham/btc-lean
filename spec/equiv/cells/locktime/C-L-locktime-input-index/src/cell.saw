import "cell.cry";
mCcltv <- llvm_load_module "c_cell_cltv_input_index.bc";
mLcltv <- llvm_load_module "l_cell_cltv_input_index.bc";
mCcsv  <- llvm_load_module "c_cell_csv_input_index.bc";
mLcsv  <- llvm_load_module "l_cell_csv_input_index.bc";

// Each leg is checked against an independent Cryptol predicate that selects
// the nIn-th slot and ignores the other one.  Equality over every
// (version/locktime, operand, seq0, seq1, nIn) tuple is the per-input claim.
let cltv_spec = do {
  txlt <- llvm_fresh_var "txlt" (llvm_int 32);
  n    <- llvm_fresh_var "n"    (llvm_int 64);
  s0   <- llvm_fresh_var "s0"   (llvm_int 32);
  s1   <- llvm_fresh_var "s1"   (llvm_int 32);
  f    <- llvm_fresh_var "nIn"  (llvm_int 1);
  llvm_execute_func [llvm_term txlt, llvm_term n, llvm_term s0, llvm_term s1, llvm_term f];
  llvm_return (llvm_term {{ cltv txlt n s0 s1 (f == 1) }});
};
llvm_verify mCcltv "cell_cltv_input_index" [] false cltv_spec abc;
llvm_verify mLcltv "cell_cltv_input_index" [] false cltv_spec abc;

let csv_spec = do {
  ver <- llvm_fresh_var "ver"  (llvm_int 32);
  n   <- llvm_fresh_var "n"    (llvm_int 64);
  s0  <- llvm_fresh_var "s0"   (llvm_int 32);
  s1  <- llvm_fresh_var "s1"   (llvm_int 32);
  f   <- llvm_fresh_var "nIn"  (llvm_int 1);
  llvm_execute_func [llvm_term ver, llvm_term n, llvm_term s0, llvm_term s1, llvm_term f];
  llvm_return (llvm_term {{ csv ver n s0 s1 (f == 1) }});
};
llvm_verify mCcsv "cell_csv_input_index" [] false csv_spec abc;
llvm_verify mLcsv "cell_csv_input_index" [] false csv_spec abc;

print "CELL_LOCKTIME_INPUT_INDEX_SAW_GREEN";
