import "cell.cry";
mC <- llvm_load_module "c_cell_csv.bc";
mL <- llvm_load_module "l_cell_csv.bc";

// Both legs are verified against the same independent Cryptol predicate for
// every (operand, flag, tx version, tx nSequence) tuple, i.e. 2^97 points.
let spec = do {
  n   <- llvm_fresh_var "n"   (llvm_int 64);
  f   <- llvm_fresh_var "flag" (llvm_int 1);
  ver <- llvm_fresh_var "ver" (llvm_int 32);
  seq <- llvm_fresh_var "seq" (llvm_int 32);
  llvm_execute_func [llvm_term n, llvm_term f, llvm_term ver, llvm_term seq];
  llvm_return (llvm_term {{ csv n (f == 1) ver seq }});
};
llvm_verify mC "cell_csv" [] false spec abc;
llvm_verify mL "cell_csv" [] false spec abc;
print "CELL_LOCKTIME_CSV_SAW_GREEN";
