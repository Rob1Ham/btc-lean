};

mC <- llvm_load_module "c_cell_add.bc";
mL <- llvm_load_module "l_cell_add.bc";
llvm_verify mC "cell_add" [] false spec_add z3;
llvm_verify mL "cell_add" [] false spec_add z3;

mC <- llvm_load_module "c_cell_sub.bc";
mL <- llvm_load_module "l_cell_sub.bc";
llvm_verify mC "cell_sub" [] false spec_sub z3;
llvm_verify mL "cell_sub" [] false spec_sub z3;

mC <- llvm_load_module "c_cell_booland.bc";
mL <- llvm_load_module "l_cell_booland.bc";
llvm_verify mC "cell_booland" [] false spec_booland z3;
llvm_verify mL "cell_booland" [] false spec_booland z3;

mC <- llvm_load_module "c_cell_boolor.bc";
mL <- llvm_load_module "l_cell_boolor.bc";
llvm_verify mC "cell_boolor" [] false spec_boolor z3;
llvm_verify mL "cell_boolor" [] false spec_boolor z3;

mC <- llvm_load_module "c_cell_numequal.bc";
mL <- llvm_load_module "l_cell_numequal.bc";
llvm_verify mC "cell_numequal" [] false spec_numequal z3;
llvm_verify mL "cell_numequal" [] false spec_numequal z3;

mC <- llvm_load_module "c_cell_numequalverify.bc";
mL <- llvm_load_module "l_cell_numequalverify.bc";
llvm_verify mC "cell_numequalverify" [] false spec_numequalverify z3;
llvm_verify mL "cell_numequalverify" [] false spec_numequalverify z3;

mC <- llvm_load_module "c_cell_numnotequal.bc";
mL <- llvm_load_module "l_cell_numnotequal.bc";
llvm_verify mC "cell_numnotequal" [] false spec_numnotequal z3;
llvm_verify mL "cell_numnotequal" [] false spec_numnotequal z3;

mC <- llvm_load_module "c_cell_lessthan.bc";
mL <- llvm_load_module "l_cell_lessthan.bc";
