// SAW leg for numeric/C-L-binary-4byte (SCR-088, SCR-090).
//
// Both legs are verified against the same independent Cryptol model for every
// (content word, length) pair of the two operands: lengths 0..4 are the full
// 4-byte CScriptNum domain, lengths 5..7 are the width-cap reject edge.  The
// entry stack is exactly the two operands, so OP_NUMEQUALVERIFY success is
// observed as the empty-stack EVAL_FALSE tail (see notes.md).
//
// `pBinary`'s opcode argument is a Cryptol literal, so each opcode gets its own
// unfolding of the same model; the model itself is shared (build/cell.cry).
import "cell.cry";

let spec_add = do {
  wa <- llvm_fresh_var "wa" (llvm_int 32);
  la <- llvm_fresh_var "la" (llvm_int 32);
  wb <- llvm_fresh_var "wb" (llvm_int 32);
  lb <- llvm_fresh_var "lb" (llvm_int 32);
  llvm_execute_func [llvm_term wa, llvm_term la, llvm_term wb, llvm_term lb];
  llvm_return (llvm_term {{ pBinary 0x0000000000000093 (zext wa) (zext (la && 0x00000007)) (zext wb) (zext (lb && 0x00000007)) }});
};

let spec_sub = do {
  wa <- llvm_fresh_var "wa" (llvm_int 32);
  la <- llvm_fresh_var "la" (llvm_int 32);
  wb <- llvm_fresh_var "wb" (llvm_int 32);
  lb <- llvm_fresh_var "lb" (llvm_int 32);
  llvm_execute_func [llvm_term wa, llvm_term la, llvm_term wb, llvm_term lb];
  llvm_return (llvm_term {{ pBinary 0x0000000000000094 (zext wa) (zext (la && 0x00000007)) (zext wb) (zext (lb && 0x00000007)) }});
};

