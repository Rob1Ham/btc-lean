import "policy.cry";

mC <- llvm_load_module "c_leaf_saw.bc";
mL <- llvm_load_module "l_leaf_saw.bc";

let spec_ht = do {
  strict <- llvm_fresh_var "strictEnc" (llvm_int 32);
  last   <- llvm_fresh_var "last"      (llvm_int 32);
  n      <- llvm_fresh_var "n"         (llvm_int 32);
  llvm_execute_func [llvm_term strict, llvm_term last, llvm_term n];
  llvm_return (llvm_term {{ hashtypeGate strict last n }});
};

let spec_htp = do {
  last <- llvm_fresh_var "last" (llvm_int 32);
  n    <- llvm_fresh_var "n"    (llvm_int 32);
  llvm_execute_func [llvm_term last, llvm_term n];
  llvm_return (llvm_term {{ (if definedHT last n then 1 else 0) : [64] }});
};

let spec_pk = do {
  strict <- llvm_fresh_var "strictEnc"         (llvm_int 32);
  wpt    <- llvm_fresh_var "witnessPubkeyType" (llvm_int 32);
  sv     <- llvm_fresh_var "sv"                (llvm_int 32);
  n      <- llvm_fresh_var "n"                 (llvm_int 32);
  pk0    <- llvm_fresh_var "pk0"               (llvm_int 32);
  llvm_execute_func [llvm_term strict, llvm_term wpt, llvm_term sv,
                     llvm_term n, llvm_term pk0];
  llvm_return (llvm_term {{ pubkeyEncoding strict wpt sv n pk0 }});
};

let spec_pkp = do {
  n   <- llvm_fresh_var "n"   (llvm_int 32);
  pk0 <- llvm_fresh_var "pk0" (llvm_int 32);
  llvm_execute_func [llvm_term n, llvm_term pk0];
  llvm_return (llvm_term {{ (0 # pubkeyPreds n pk0) : [64] }});
};

r1  <- llvm_verify mC "cell_hashtype_gate"   [] false spec_ht   abc; print "PROOF cell_hashtype_gate C";
r2  <- llvm_verify mL "cell_hashtype_gate"   [] false spec_ht   abc; print "PROOF cell_hashtype_gate L";
r3  <- llvm_verify mC "cell_is_defined_hashtype" [] false spec_htp abc; print "PROOF cell_is_defined_hashtype C";
r4  <- llvm_verify mL "cell_is_defined_hashtype" [] false spec_htp abc; print "PROOF cell_is_defined_hashtype L";
r5  <- llvm_verify mC "cell_pubkey_encoding" [] false spec_pk   abc; print "PROOF cell_pubkey_encoding C";
r6  <- llvm_verify mL "cell_pubkey_encoding" [] false spec_pk   abc; print "PROOF cell_pubkey_encoding L";
r7  <- llvm_verify mC "cell_pubkey_predicates" [] false spec_pkp abc; print "PROOF cell_pubkey_predicates C";
r8  <- llvm_verify mL "cell_pubkey_predicates" [] false spec_pkp abc; print "PROOF cell_pubkey_predicates L";
print "CELL_POLICY_SAW_GREEN";
