import "pk_encoding.cry";

mC <- llvm_load_module "c_leaf_saw.bc";
mL <- llvm_load_module "l_leaf_saw.bc";

let spec_encoding = do {
  h  <- llvm_fresh_var "hdr" (llvm_int 8);
  l  <- llvm_fresh_var "len" (llvm_int 32);
  se <- llvm_fresh_var "strict_enc" (llvm_int 32);
  wp <- llvm_fresh_var "witness_pubkey_type" (llvm_int 32);
  sv <- llvm_fresh_var "sv" (llvm_int 32);
  llvm_execute_func [llvm_term h, llvm_term l, llvm_term se, llvm_term wp,
                     llvm_term sv];
  llvm_return (llvm_term {{ encodingOut h l se wp sv }});
};

let spec_checksig = do {
  h  <- llvm_fresh_var "hdr" (llvm_int 8);
  l  <- llvm_fresh_var "len" (llvm_int 32);
  se <- llvm_fresh_var "strict_enc" (llvm_int 32);
  wp <- llvm_fresh_var "witness_pubkey_type" (llvm_int 32);
  sv <- llvm_fresh_var "sv" (llvm_int 32);
  sl <- llvm_fresh_var "sig_len" (llvm_int 32);
  co <- llvm_fresh_var "crypto_ok" (llvm_int 32);
  nf <- llvm_fresh_var "null_fail" (llvm_int 32);
  llvm_execute_func [llvm_term h, llvm_term l, llvm_term se, llvm_term wp,
                     llvm_term sv, llvm_term sl, llvm_term co, llvm_term nf];
  llvm_return (llvm_term {{ checksigOut h l se wp sv sl co nf 0 }});
};

let spec_continue = do {
  h  <- llvm_fresh_var "hdr" (llvm_int 8);
  l  <- llvm_fresh_var "len" (llvm_int 32);
  se <- llvm_fresh_var "strict_enc" (llvm_int 32);
  wp <- llvm_fresh_var "witness_pubkey_type" (llvm_int 32);
  sv <- llvm_fresh_var "sv" (llvm_int 32);
  sl <- llvm_fresh_var "sig_len" (llvm_int 32);
  co <- llvm_fresh_var "crypto_ok" (llvm_int 32);
  nf <- llvm_fresh_var "null_fail" (llvm_int 32);
  llvm_execute_func [llvm_term h, llvm_term l, llvm_term se, llvm_term wp,
                     llvm_term sv, llvm_term sl, llvm_term co, llvm_term nf];
  llvm_return (llvm_term {{ checksigOut h l se wp sv sl co nf 1 }});
};

r1 <- llvm_verify mC "cell_pubkey_encoding" [] false spec_encoding abc;
print "PROOF cell_pubkey_encoding C";
r2 <- llvm_verify mL "cell_pubkey_encoding" [] false spec_encoding abc;
print "PROOF cell_pubkey_encoding L";
r3 <- llvm_verify mC "cell_pubkey_encoding_checksig" [] false spec_checksig abc;
print "PROOF cell_pubkey_encoding_checksig C";
r4 <- llvm_verify mL "cell_pubkey_encoding_checksig" [] false spec_checksig abc;
print "PROOF cell_pubkey_encoding_checksig L";
r5 <- llvm_verify mC "cell_pubkey_encoding_continue" [] false spec_continue abc;
print "PROOF cell_pubkey_encoding_continue C";
r6 <- llvm_verify mL "cell_pubkey_encoding_continue" [] false spec_continue abc;
print "PROOF cell_pubkey_encoding_continue L";
print "CELL_PUBKEY_ENCODING_SAW_GREEN";
