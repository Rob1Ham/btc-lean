llvm_verify mC2 "cell_p2wpkh_w2" [] false spec2 abc;
llvm_verify mL2 "cell_p2wpkh_w2" [] false spec2 abc;

mC3 <- llvm_load_module "c_cell_p2wpkh_w3.bc";
mL3 <- llvm_load_module "l_cell_p2wpkh_w3.bc";
let spec3 = do {
  p0 <- llvm_fresh_var "p0" (llvm_int 64);
  p1 <- llvm_fresh_var "p1" (llvm_int 64);
  p2 <- llvm_fresh_var "p2" (llvm_int 64);
  llvm_execute_func [llvm_term p0, llvm_term p1, llvm_term p2];
  llvm_return (llvm_term {{ w3 p0 p1 p2 }});
};
llvm_verify mC3 "cell_p2wpkh_w3" [] false spec3 abc;
llvm_verify mL3 "cell_p2wpkh_w3" [] false spec3 abc;
