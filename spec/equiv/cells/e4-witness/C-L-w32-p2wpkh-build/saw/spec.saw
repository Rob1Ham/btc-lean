import "spec.cry";

// Four word witnesses; each pair (C module, L module) is verified against the
// same Cryptol reconstruction, so C = spec = L for every 160-bit program.

mC0 <- llvm_load_module "c_cell_p2wpkh_w0.bc";
mL0 <- llvm_load_module "l_cell_p2wpkh_w0.bc";
let spec0 = do {
  p0 <- llvm_fresh_var "p0" (llvm_int 64);
  p1 <- llvm_fresh_var "p1" (llvm_int 64);
  p2 <- llvm_fresh_var "p2" (llvm_int 64);
  llvm_execute_func [llvm_term p0, llvm_term p1, llvm_term p2];
  llvm_return (llvm_term {{ w0 p0 p1 p2 }});
};
llvm_verify mC0 "cell_p2wpkh_w0" [] false spec0 abc;
llvm_verify mL0 "cell_p2wpkh_w0" [] false spec0 abc;

mC1 <- llvm_load_module "c_cell_p2wpkh_w1.bc";
mL1 <- llvm_load_module "l_cell_p2wpkh_w1.bc";
