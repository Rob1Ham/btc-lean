  llvm_execute_func [llvm_term p0, llvm_term p1, llvm_term p2];
  llvm_return (llvm_term {{ w1 p0 p1 p2 }});
};
llvm_verify mC1 "cell_p2wpkh_w1" [] false spec1 abc;
llvm_verify mL1 "cell_p2wpkh_w1" [] false spec1 abc;

