import "spec.cry";

mC <- llvm_load_module "c_cell_v0_error_total.bc";
mL <- llvm_load_module "l_cell_v0_error_total.bc";
let spec = do {
  plen    <- llvm_fresh_var "plen"    (llvm_int 64);
  wn      <- llvm_fresh_var "wn"      (llvm_int 64);
  hash_ok <- llvm_fresh_var "hash_ok" (llvm_int 64);
  er      <- llvm_fresh_var "er"      (llvm_int 64);
  ee      <- llvm_fresh_var "ee"      (llvm_int 64);
  llvm_execute_func [llvm_term plen, llvm_term wn, llvm_term hash_ok,
                     llvm_term er, llvm_term ee];
  llvm_return (llvm_term {{ v0_error_total plen wn hash_ok er ee }});
};
llvm_verify mC "cell_v0_error_total" [] false spec abc;
llvm_verify mL "cell_v0_error_total" [] false spec abc;
