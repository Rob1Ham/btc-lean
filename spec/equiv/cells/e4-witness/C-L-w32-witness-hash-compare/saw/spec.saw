import "spec.cry";

mC <- llvm_load_module "c_cell_hash_compare.bc";
mL <- llvm_load_module "l_cell_hash_compare.bc";
let spec = do {
  h0 <- llvm_fresh_var "h0" (llvm_int 64);
  h1 <- llvm_fresh_var "h1" (llvm_int 64);
  h2 <- llvm_fresh_var "h2" (llvm_int 64);
  h3 <- llvm_fresh_var "h3" (llvm_int 64);
  p0 <- llvm_fresh_var "p0" (llvm_int 64);
  p1 <- llvm_fresh_var "p1" (llvm_int 64);
  p2 <- llvm_fresh_var "p2" (llvm_int 64);
  p3 <- llvm_fresh_var "p3" (llvm_int 64);
  er <- llvm_fresh_var "er" (llvm_int 64);
  ee <- llvm_fresh_var "ee" (llvm_int 64);
  llvm_execute_func [llvm_term h0, llvm_term h1, llvm_term h2, llvm_term h3,
                     llvm_term p0, llvm_term p1, llvm_term p2, llvm_term p3,
                     llvm_term er, llvm_term ee];
  llvm_return (llvm_term {{ hashCompare h0 h1 h2 h3 p0 p1 p2 p3 er ee }});
};
llvm_verify mC "cell_hash_compare" [] false spec abc;
llvm_verify mL "cell_hash_compare" [] false spec abc;
