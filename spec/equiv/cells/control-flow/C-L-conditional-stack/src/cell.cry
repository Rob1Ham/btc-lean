module CellCondStack where

// Independent Cryptol specification of the conditional-stack opcodes over the
// cell's bounded state: one dispatch followed by loop exit.
//
// Core: src/script/interpreter.cpp:493 (gate), :647-653 (OP_ELSE),
// :655-661 (OP_ENDIF), :1245-1246 (non-empty condition stack after the loop).
//
//   * a non-conditional opcode (OP_NOP) in an unexecuted branch is skipped by
//     the gate, so its handler does not run;
//   * OP_ELSE/OP_ENDIF are in [OP_IF..OP_ENDIF], so they are dispatched even
//     when fExec is false;
//   * OP_ELSE on an empty condition stack is UNBALANCED_CONDITIONAL (20),
//     otherwise it toggles the top;
//   * OP_ENDIF on an empty condition stack is UNBALANCED_CONDITIONAL (20),
//     otherwise it pops;
//   * after the loop a non-empty condition stack is UNBALANCED_CONDITIONAL.
//
// Observable: result(2) | error(6) | n(2)@8 | v0@10 | v1@11 | executed@12.
// `op`: 0 = OP_ELSE, 1 = OP_ENDIF, anything else = OP_NOP.  Condition-stack
// depth is bounded at 2 (the cell domain).

to64 : [32] -> [64]
to64 x = zext x

packObs : [32] -> [32] -> [32] -> [32] -> [32] -> [64]
packObs err n v0 v1 ex =
  ((if err == 0 then 1 else 0) : [64]) ||
  (to64 (err && (63 : [32])) << 2) ||
  (to64 (n && (3 : [32])) << 8) ||
  (to64 (v0 && (1 : [32])) << 10) ||
  (to64 (v1 && (1 : [32])) << 11) ||
  (to64 (ex && (1 : [32])) << 12)

wire : [32] -> [32]
wire op = if op == 0 then (103 : [32])
          else if op == 1 then (104 : [32])
          else (97 : [32])

step : [32] -> [32] -> [32] -> [32] -> [32] -> [64]
step op fexec n v0 v1 =
  packObs err n1 v0' v1' ex
  where
    w = wire op
    inG = ((99 : [32]) <= w) && (w <= (104 : [32]))
    disp = fexec != 0 \/ inG
    isElse = op == 0
    isEndif = op == 1
    e0 = if ~ disp then 0
         else if (isElse \/ isEndif) /\ n == 0 then 20
         else 0
    n1 = if disp /\ isEndif /\ n != 0 then n - 1 else n
    // loop exit (interpreter.cpp:1245-1246)
    err = if e0 == 0 /\ n1 != 0 then 20 else e0
    v0' = if disp /\ isElse /\ n != 0 then (if v0 == 0 then 1 else 0)
          else if disp /\ isEndif /\ n != 0 then v1
          else v0
    v1' = if disp /\ isEndif /\ n != 0 then 0 else v1
    ex = if disp /\ ~ isElse /\ ~ isEndif then 1 else 0
