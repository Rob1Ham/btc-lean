module CellCastToBool where

// Independent specification of Bitcoin Core CastToBool
// (src/script/interpreter.cpp:46-59 at cce32b168) for element lengths 0..2:
//
//   * the empty vector is false;
//   * any nonzero byte is true;
//   * the lone byte 0x80 (negative zero) is false;
//   * a zero byte is skipped, so a zero prefix defers to the last byte.
//
// The loop's only special case is `i == size-1 && vch[i] == 0x80`; for a
// two-byte vector position 0 is never the last byte, so 0x80 there is true.

cast_empty : [32]
cast_empty = 0

cast1 : [8] -> [32]
cast1 b0 = if b0 == 0 \/ b0 == 0x80 then 0 else 1

cast2 : [8] -> [8] -> [32]
cast2 b0 b1 = if b0 != 0 then 1
              else if b1 == 0 \/ b1 == 0x80 then 0 else 1
