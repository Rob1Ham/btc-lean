import "cell.cry";
mC0 <- llvm_load_module "c_cell_verify_len0.bc";
mL0 <- llvm_load_module "l_cell_verify_len0.bc";
mC1 <- llvm_load_module "c_cell_verify_len1.bc";
mL1 <- llvm_load_module "l_cell_verify_len1.bc";
mC2 <- llvm_load_module "c_cell_verify_len2.bc";
mL2 <- llvm_load_module "l_cell_verify_len2.bc";

// Symbolic over stack depth and every byte value at each modelled length.
let s0 = do {
  d <- llvm_fresh_var "d" (llvm_int 32);
  llvm_execute_func [llvm_term d];
  llvm_return (llvm_term {{ packed0 d }});
};
let s1 = do {
  d  <- llvm_fresh_var "d"  (llvm_int 32);
  b0 <- llvm_fresh_var "b0" (llvm_int 8);
  llvm_execute_func [llvm_term d, llvm_term b0];
  llvm_return (llvm_term {{ packed1 d b0 }});
};
let s2 = do {
  d  <- llvm_fresh_var "d"  (llvm_int 32);
  b0 <- llvm_fresh_var "b0" (llvm_int 8);
  b1 <- llvm_fresh_var "b1" (llvm_int 8);
  llvm_execute_func [llvm_term d, llvm_term b0, llvm_term b1];
  llvm_return (llvm_term {{ packed2 d b0 b1 }});
};
llvm_verify mC0 "cell_verify_len0" [] false s0 abc;
llvm_verify mL0 "cell_verify_len0" [] false s0 abc;
llvm_verify mC1 "cell_verify_len1" [] false s1 abc;
llvm_verify mL1 "cell_verify_len1" [] false s1 abc;
llvm_verify mC2 "cell_verify_len2" [] false s2 abc;
llvm_verify mL2 "cell_verify_len2" [] false s2 abc;
print "CELL_control_VERIFY_SAW_GREEN";
