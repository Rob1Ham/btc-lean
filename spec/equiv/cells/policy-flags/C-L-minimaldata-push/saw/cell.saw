import "cell.cry";

mC <- llvm_load_module "c_leaf.bc";
mL <- llvm_load_module "l_leaf.bc";

let spec_cell_minimaldata_push = do {
  flags <- llvm_fresh_var "cell_minimaldata_push_flags" (llvm_int 64);
  fExec <- llvm_fresh_var "cell_minimaldata_push_fExec" (llvm_int 64);
  opcode <- llvm_fresh_var "cell_minimaldata_push_opcode" (llvm_int 64);
  dataLen <- llvm_fresh_var "cell_minimaldata_push_dataLen" (llvm_int 64);
  b0Arg <- llvm_fresh_var "cell_minimaldata_push_b0Arg" (llvm_int 64);
  llvm_execute_func [llvm_term flags, llvm_term fExec, llvm_term opcode, llvm_term dataLen, llvm_term b0Arg];
  llvm_return (llvm_term {{ minimaldata_push flags fExec opcode dataLen b0Arg }});
};

llvm_verify mC "cell_minimaldata_push" [] false spec_cell_minimaldata_push abc;
llvm_verify mL "cell_minimaldata_push" [] false spec_cell_minimaldata_push abc;

print "CELL_policy_flags_minimaldata_SAW_GREEN";
