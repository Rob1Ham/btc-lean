import "cell.cry";

mC <- llvm_load_module "c_leaf.bc";
mL <- llvm_load_module "l_leaf.bc";

let spec_cell_cleanstack = do {
  flags <- llvm_fresh_var "cell_cleanstack_flags" (llvm_int 64);
  sv <- llvm_fresh_var "cell_cleanstack_sv" (llvm_int 64);
  finalLen <- llvm_fresh_var "cell_cleanstack_finalLen" (llvm_int 64);
  llvm_execute_func [llvm_term flags, llvm_term sv, llvm_term finalLen];
  llvm_return (llvm_term {{ cleanstack flags sv finalLen }});
};

llvm_verify mC "cell_cleanstack" [] false spec_cell_cleanstack abc;
llvm_verify mL "cell_cleanstack" [] false spec_cell_cleanstack abc;

print "CELL_policy_flags_cleanstack_SAW_GREEN";
