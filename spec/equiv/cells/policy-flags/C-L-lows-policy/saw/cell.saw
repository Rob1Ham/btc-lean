import "cell.cry";

mC <- llvm_load_module "c_leaf.bc";
mL <- llvm_load_module "l_leaf.bc";

let spec_cell_lows_policy = do {
  flags <- llvm_fresh_var "cell_lows_policy_flags" (llvm_int 64);
  rByte <- llvm_fresh_var "cell_lows_policy_rByte" (llvm_int 64);
  s0 <- llvm_fresh_var "cell_lows_policy_s0" (llvm_int 64);
  s1 <- llvm_fresh_var "cell_lows_policy_s1" (llvm_int 64);
  s2 <- llvm_fresh_var "cell_lows_policy_s2" (llvm_int 64);
  s3 <- llvm_fresh_var "cell_lows_policy_s3" (llvm_int 64);
  llvm_execute_func [llvm_term flags, llvm_term rByte, llvm_term s0, llvm_term s1, llvm_term s2, llvm_term s3];
  llvm_return (llvm_term {{ lows flags rByte s0 s1 s2 s3 }});
};

llvm_verify mC "cell_lows_policy" [] false spec_cell_lows_policy abc;
llvm_verify mL "cell_lows_policy" [] false spec_cell_lows_policy abc;

print "CELL_policy_flags_lows_SAW_GREEN";
