import "cell.cry";

mC <- llvm_load_module "c_leaf.bc";
mL <- llvm_load_module "l_leaf.bc";

let spec_cell_strictenc_pubkey = do {
  flags <- llvm_fresh_var "cell_strictenc_pubkey_flags" (llvm_int 64);
  pkLen <- llvm_fresh_var "cell_strictenc_pubkey_pkLen" (llvm_int 64);
  pk0 <- llvm_fresh_var "cell_strictenc_pubkey_pk0" (llvm_int 64);
  llvm_execute_func [llvm_term flags, llvm_term pkLen, llvm_term pk0];
  llvm_return (llvm_term {{ strictenc_pubkey flags pkLen pk0 }});
};

llvm_verify mC "cell_strictenc_pubkey" [] false spec_cell_strictenc_pubkey abc;
llvm_verify mL "cell_strictenc_pubkey" [] false spec_cell_strictenc_pubkey abc;

print "CELL_policy_flags_strictenc_SAW_GREEN";
