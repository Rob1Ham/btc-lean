import "cell.cry";

mC <- llvm_load_module "c_leaf.bc";
mL <- llvm_load_module "l_leaf.bc";

let spec_cell_nullfail = do {
  flags <- llvm_fresh_var "cell_nullfail_flags" (llvm_int 64);
  fSuccess <- llvm_fresh_var "cell_nullfail_fSuccess" (llvm_int 64);
  sigLen <- llvm_fresh_var "cell_nullfail_sigLen" (llvm_int 64);
  llvm_execute_func [llvm_term flags, llvm_term fSuccess, llvm_term sigLen];
  llvm_return (llvm_term {{ nullfail flags fSuccess sigLen }});
};

llvm_verify mC "cell_nullfail" [] false spec_cell_nullfail abc;
llvm_verify mL "cell_nullfail" [] false spec_cell_nullfail abc;

print "CELL_policy_flags_nullfail_SAW_GREEN";
