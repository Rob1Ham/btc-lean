import "cell.cry";

mC <- llvm_load_module "c_leaf.bc";
mL <- llvm_load_module "l_leaf.bc";

// SCR-152: every wire byte 0x00..0xff (256 cases), both legs against the
// explicit interval table in cell.cry.
let spec = do {
  w <- llvm_fresh_var "w" (llvm_int 8);
  llvm_execute_func [llvm_term w];
  llvm_return (llvm_term {{ is_op_success w }});
};
llvm_verify mC "cell_is_op_success" [] false spec abc;
llvm_verify mL "cell_is_op_success" [] false spec abc;

print "CELL_W32_OP_SUCCESS_SET_SAW_GREEN";
