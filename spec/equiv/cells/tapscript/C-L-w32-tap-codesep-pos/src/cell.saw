import "cell.cry";

// SCR-167: every field of the bounded pre-decoded stream is symbolic:
// pend, and for each of four opcodes its kind (push/op), wire byte, push
// payload length and fExec bit.
mC <- llvm_load_module "c_cell_codesep_walk.bc";
mL <- llvm_load_module "l_cell_codesep_walk.bc";
let spec = do {
  pend <- llvm_fresh_var "pend" (llvm_int 32);
  k0 <- llvm_fresh_var "k0" (llvm_int 32);
  w0 <- llvm_fresh_var "w0" (llvm_int 32);
  l0 <- llvm_fresh_var "l0" (llvm_int 32);
  e0 <- llvm_fresh_var "e0" (llvm_int 32);
  k1 <- llvm_fresh_var "k1" (llvm_int 32);
  w1 <- llvm_fresh_var "w1" (llvm_int 32);
  l1 <- llvm_fresh_var "l1" (llvm_int 32);
  e1 <- llvm_fresh_var "e1" (llvm_int 32);
  k2 <- llvm_fresh_var "k2" (llvm_int 32);
  w2 <- llvm_fresh_var "w2" (llvm_int 32);
  l2 <- llvm_fresh_var "l2" (llvm_int 32);
  e2 <- llvm_fresh_var "e2" (llvm_int 32);
  k3 <- llvm_fresh_var "k3" (llvm_int 32);
  w3 <- llvm_fresh_var "w3" (llvm_int 32);
  l3 <- llvm_fresh_var "l3" (llvm_int 32);
  e3 <- llvm_fresh_var "e3" (llvm_int 32);
  llvm_execute_func [llvm_term pend,
    llvm_term k0, llvm_term w0, llvm_term l0, llvm_term e0,
    llvm_term k1, llvm_term w1, llvm_term l1, llvm_term e1,
    llvm_term k2, llvm_term w2, llvm_term l2, llvm_term e2,
    llvm_term k3, llvm_term w3, llvm_term l3, llvm_term e3];
  llvm_return (llvm_term {{ walk pend (k0,w0,l0,e0) (k1,w1,l1,e1)
                                   (k2,w2,l2,e2) (k3,w3,l3,e3) }});
};
llvm_verify mC "cell_codesep_walk" [] false spec z3;
llvm_verify mL "cell_codesep_walk" [] false spec z3;

print "CELL_W32_CODESEP_POS_SAW_GREEN";
