module CellCodesepByteseq where

// Independent specification of SCR-167 for a bounded six-byte script.
// Written from interpreter.cpp:431-446,1058-1066 and script.cpp:313-363
// (C) / Defs.lean:601-604,1031-1032,1145-1150 and Ops.lean:50-78 (L).
//
// State: (pc, opcodeIndex, codeSep, codeSepPos, bad)
//   pc          byte cursor, starts at 0
//   opcodeIndex 0-based parsed-opcode index, +1 per successfully parsed op
//   codeSep     legacy pbegincodehash byte offset, starts at 0
//   codeSepPos  tapscript m_codeseparator_pos, starts at 0xFFFFFFFF
//   bad         1 once GetOp fails
//
// Observable packing (cell harness):
//   bits 0..31  codeSepPos
//   bits 32..35 codeSep (byte offset)
//   bits 36..39 opcodeIndex
//   bit  40     sepOk = separation invariant
//   bit  41     bad
//   bits 42..45 pc (final byte cursor)

type St = ([32], [32], [32], [32], [1])

// Out-of-range byte reads return 0, mirroring the leaf's bat().
bat : [6][8] -> [32] -> [32]
bat s i =
  if i == 0 then (zext (s @ 0) : [32])
  else if i == 1 then (zext (s @ 1) : [32])
  else if i == 2 then (zext (s @ 2) : [32])
  else if i == 3 then (zext (s @ 3) : [32])
  else if i == 4 then (zext (s @ 4) : [32])
  else if i == 5 then (zext (s @ 5) : [32])
  else 0

// GetOp at byte index i: (valid, opcode, next offset).
getop : [6][8] -> [32] -> ([1], [32], [32])
getop s i =
  if i >= (6 : [32]) then (0, 0, 0)
  else if bat s i <= (0x0000004b : [32]) then
    (if (zext i : [64]) + 1 + (zext (bat s i) : [64]) <= (6 : [64])
       then (1, bat s i, i + 1 + bat s i) else (0, 0, 0))
  else if bat s i == (0x0000004c : [32]) then
    (if i + 1 >= (6 : [32]) then (0, 0, 0)
     else if (zext i : [64]) + 2 + (zext (bat s (i + 1)) : [64]) <= (6 : [64])
       then (1, bat s i, i + 2 + bat s (i + 1)) else (0, 0, 0))
  else if bat s i == (0x0000004d : [32]) then
    (if i + 2 >= (6 : [32]) then (0, 0, 0)
     else if (zext i : [64]) + 3
             + (zext (bat s (i + 1)) : [64])
             + (zext (bat s (i + 2)) : [64]) * 256 <= (6 : [64])
       then (1, bat s i, i + 3 + bat s (i + 1) + bat s (i + 2) * 256)
       else (0, 0, 0))
  else if bat s i == (0x0000004e : [32]) then
    (if i + 4 >= (6 : [32]) then (0, 0, 0)
     else if (zext i : [64]) + 5
             + (zext (bat s (i + 1)) : [64])
             + (zext (bat s (i + 2)) : [64]) * 256
             + (zext (bat s (i + 3)) : [64]) * 65536
             + (zext (bat s (i + 4)) : [64]) * 16777216 <= (6 : [64])
       then (1, bat s i, i + 5 + bat s (i + 1) + bat s (i + 2) * 256
                            + bat s (i + 3) * 65536 + bat s (i + 4) * 16777216)
       else (0, 0, 0))
  else (1, bat s i, i + 1)

okOf : ([1], [32], [32]) -> [1]
okOf (a, _, _) = a
opOf : ([1], [32], [32]) -> [32]
opOf (_, b, _) = b
nxOf : ([1], [32], [32]) -> [32]
nxOf (_, _, c) = c

step : [6][8] -> [32] -> St -> St
step s mask (pc, idx, cs, sep, bad) =
  if (bad != 0) || (pc >= (6 : [32])) then (pc, idx, cs, sep, bad)
  else if okOf (getop s pc) == 0 then (pc, idx, cs, sep, 1)
  else if ((((mask >> idx) && 1) != 0) && (opOf (getop s pc) == (0x000000ab : [32])))
    // executed OP_CODESEPARATOR: both fields update, to different values
    then (nxOf (getop s pc), idx + 1, nxOf (getop s pc), idx, 0)
    // parsed but not executed: only the opcode index advances
    else (nxOf (getop s pc), idx + 1, cs, sep, 0)

final : [6][8] -> [32] -> St
final s mask =
  step s mask (step s mask (step s mask
  (step s mask (step s mask (step s mask
    (0, 0, 0, 0xffffffff, 0))))))

// Strict separation: with no executed separator the legacy offset is 0
// while the tapscript field is the sentinel; after any executed separator
// the byte offset is at least one greater than the recorded opcode index
// (each parsed opcode spans >= 1 byte).  The two values are never equal.
sepOk : St -> [1]
sepOk (_, _, cs, sep, _) =
  if sep == (0xffffffff : [32])
    then (if cs == 0 then 1 else 0)
    else (if cs > sep then 1 else 0)

packed : St -> [64]
packed (pc, idx, cs, sep, bad) =
  (zext sep : [64])
  || ((zext cs : [64]) << 32)
  || ((zext idx : [64]) << 36)
  || ((zext (sepOk (pc, idx, cs, sep, bad)) : [64]) << 40)
  || ((zext bad : [64]) << 41)
  || ((zext pc : [64]) << 42)
