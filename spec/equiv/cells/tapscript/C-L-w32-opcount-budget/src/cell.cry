module CellOpcountBudget where

// Independent specification of the MAX_OPS guard (interpreter.cpp:460-464) and
// of the one-OP_NOP tapscript path, stated as a total function of the packed
// observable (w32_common.h):
//   result(2) | error(6) << 2 | nOpCount(32) << 8
//
// Domain: SigVersion 0=BASE, 1=WITNESS_V0, 2=TAPSCRIPT; nOpCount <= 10000
// (unreachable above that, see spec.md).  Anything else is the bad-input
// marker 6 = result 2, UNKNOWN_ERROR 1.
//
// OP_COUNT = 7, EVAL_FALSE = 2, MAX_OPS_PER_SCRIPT = 201, OP_16 = 0x60.

pack : [2] -> [6] -> [32] -> [64]
pack r e aux = (zext r) || ((zext e) << 2) || ((zext aux) << 8)

counts_for : [32] -> [8] -> Bit
counts_for sv w = (sv == 0 \/ sv == 1) /\ (w > 0x60)

opcount_guard : [32] -> [8] -> [32] -> [64]
opcount_guard sv w oc =
  if sv > 2 \/ oc > 10000 then 6
  else if counts_for sv w
         then (if oc + 1 > 201 then pack 0 7 (oc + 1) else pack 1 0 (oc + 1))
         else pack 1 0 oc

nop_overbudget : [32] -> [32] -> [32] -> [64]
nop_overbudget sv oc tt =
  if sv > 2 \/ oc > 10000 then 6
  else if counts_for sv 0x61
         then (if oc + 1 > 201 then pack 0 7 (oc + 1)
               else (if tt == 0 then pack 0 2 (oc + 1) else pack 1 0 (oc + 1)))
         else (if tt == 0 then pack 0 2 oc else pack 1 0 oc)
