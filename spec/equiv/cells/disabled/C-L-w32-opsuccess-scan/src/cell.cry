module CellOpSuccessScan where

// Independent Cryptol specification for script.cpp:365-371 (IsOpSuccess) and
// the interpreter.cpp:1846-1862 tapscript pre-scan over two opcode bytes.
// Codes: 0 OK, 36 DISCOURAGE_OP_SUCCESS, 66 no success, 254 out of domain.

opSuccess : [8] -> Bit
opSuccess w =
  (w == 80) || (w == 98) ||
  ((126 <= w) && (w <= 129)) ||
  ((131 <= w) && (w <= 134)) ||
  ((137 <= w) && (w <= 138)) ||
  ((141 <= w) && (w <= 142)) ||
  ((149 <= w) && (w <= 153)) ||
  ((187 <= w) && (w <= 254))

flagOut : [32] -> [64]
flagOut discourage = if (discourage && 1) != 0 then 36 else 0

scan : [8] -> [8] -> [32] -> [64]
scan w0 w1 discourage =
  if (w0 < 0x4f) || (w1 < 0x4f) then 254
  else if opSuccess w0 then flagOut discourage
  else if opSuccess w1 then flagOut discourage
  else 66
