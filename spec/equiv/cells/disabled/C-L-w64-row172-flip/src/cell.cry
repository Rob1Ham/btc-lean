module CellRow172Flip where

// Independent Cryptol specification for SCR-172's BASE-vs-TAPSCRIPT flip.
//
// Base side: Bitcoin Core interpreter.cpp:467-482 (disabled arm) restricted
// to a single non-push opcode at top level (fExec=true, op budget clear).
// Tapscript side: interpreter.cpp:1846-1862 OP_SUCCESSx pre-scan over one
// byte, script.cpp:365-371 IsOpSuccess, with the DISCOURAGE_OP_SUCCESS
// policy bit at script_verify_flag_name ordinal 19 (1 << 19).
//
// Codes: 0 OK, 17 DISABLED_OPCODE, 36 DISCOURAGE_OP_SUCCESS,
// 64 base reaches the switch (marker), 66 scan completes (marker),
// 254 outside the one-byte non-push domain.

disabledWire : [8] -> Bit
disabledWire w =
  (w == 0x7e) || (w == 0x7f) || (w == 0x80) || (w == 0x81) ||
  (w == 0x83) || (w == 0x84) || (w == 0x85) || (w == 0x86) ||
  (w == 0x8d) || (w == 0x8e) || (w == 0x95) || (w == 0x96) ||
  (w == 0x97) || (w == 0x98) || (w == 0x99)

opSuccess : [8] -> Bit
opSuccess w =
  (w == 80) || (w == 98) ||
  ((126 <= w) && (w <= 129)) ||
  ((131 <= w) && (w <= 134)) ||
  ((137 <= w) && (w <= 138)) ||
  ((141 <= w) && (w <= 142)) ||
  ((149 <= w) && (w <= 153)) ||
  ((187 <= w) && (w <= 254))

policyBit : [64] -> Bit
policyBit flags = (flags && (1 << 19)) != 0

baseOutcome : [8] -> [32]
baseOutcome w =
  if w < 0x4f then 254
  else if disabledWire w then 17
  else 64

tapOutcome : [8] -> [64] -> [32]
tapOutcome w flags =
  if w < 0x4f then 254
  else if opSuccess w then (if policyBit flags then 36 else 0)
  else 66

to64 : [32] -> [64]
to64 x = zext x

pair : [8] -> [64] -> [64]
pair w flags = (to64 (baseOutcome w) << 32) || to64 (tapOutcome w flags)

// 1 exactly when the same byte is a legacy consensus disabled error in BASE
// and an OP_SUCCESSx result in tapscript (OK, or the policy-flag error 36).
flip : [8] -> [64] -> [64]
flip w flags =
  if (baseOutcome w == (17 : [32])) &&
     ((tapOutcome w flags == (0 : [32])) ||
      (tapOutcome w flags == (36 : [32])))
  then 1
  else 0
