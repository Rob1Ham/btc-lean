/-! ## Row and matrix checks against the Python reference -/

/-- Kernel-friendly byte-wise Bool equality: only `==`/`&&`/`List.all`,
no Prop conjunction, no well-founded helper — reduces under `rfl`. -/
def rowBEq (a b : ByteArray) : Bool :=
  (a.size == b.size) && (List.range a.size).all (fun i => a.get! i == b.get! i)

/-- One matrix row: Core's root for shape `n` byte-equals the reference root. -/
def rowCheck (n : Nat) : Bool := rowBEq (shapeRoot n) (expectedRoot n)

/-- The full 64-row matrix: all rows ANDed. -/
def matrixCheck : Bool := (List.range 64).all rowCheck

/-! ## General statements (sorry-free, sha256d opaque) -/

/-- `leavesOf n` really has `n` leaves (for the 64 dummy leaves). -/
theorem leavesOf_length (n : Nat) (hn : n ≤ 64) : (leavesOf n).length = n := by
  have h : (leavesOf n).length = min n leaves.length := by
    simp only [leavesOf, List.length_take]
  have h64 : leaves.length = 64 := by
    simp only [leaves, List.length_map, List.length_range]
  rw [h, h64]
  omega

/-- **Fuel honesty over all 64 shapes**: for the n-tx dummy leaf vector,
ANY fuel `≥ n` computes the same root as `shapeRoot n`. -/
theorem shapeRoot_fuel (n : Nat) (hn1 : 1 ≤ n) (hn64 : n ≤ 64)
    (f : Nat) (hf : n ≤ f) :
    merkleRootOfF f (leavesOf n) = shapeRoot n := by
  have hlen := leavesOf_length n hn64
  have hlen1 : 1 ≤ (leavesOf n).length := by rw [hlen]; omega
  have hlenf : (leavesOf n).length ≤ f := by rw [hlen]; omega
  have h := merkleRootOfF_fuel_irrelevant f (leavesOf n) hlen1 hlenf
  show merkleRootOfF f (leavesOf n)
      = merkleRootOfF ((leavesOf n).length + 1) (leavesOf n)
  rw [hlen] at h ⊢
  exact h

/-- **The level fold determines the root** (any shape with ≥ 2 leaves):
the executable root is invariant under one explicit `merkleLevel` fold.
With `merkleRootOf [a] = a` (rfl) this pins the root as the fold of the
positional pairing semantics (BLK-009 order + BLK-008 odd duplicate-last)
down to a singleton. -/
theorem root_level_step (l : List ByteArray) (h2 : 2 ≤ l.length) :
    merkleRootOf l = merkleRootOf (merkleLevel l) := by
  cases l with
  | nil => simp at h2
  | cons a t =>
    cases t with
    | nil => simp at h2
    | cons b rest =>
      have hlen2 : (a :: b :: rest).length = rest.length + 2 := rfl
      have hlen' := merkleLevel_length_add1 (a :: b :: rest)
      have hlev1 : 1 ≤ (merkleLevel (a :: b :: rest)).length := by omega
      have hlevle : (merkleLevel (a :: b :: rest)).length ≤ rest.length + 2 := by omega
      show merkleRootOfF (rest.length + 2 + 1) (a :: b :: rest)
          = merkleRootOfF ((merkleLevel (a :: b :: rest)).length + 1)
              (merkleLevel (a :: b :: rest))
      rw [show merkleRootOfF (rest.length + 2 + 1) (a :: b :: rest)
            = merkleRootOfF (rest.length + 2) (merkleLevel (a :: b :: rest)) from rfl]
      have hF := merkleRootOfF_fuel_irrelevant (rest.length + 2)
        (merkleLevel (a :: b :: rest)) hlev1 hlevle
      rw [← hF]

/-- **The 3-tx shape end-to-end** (two levels, odd-tail duplicate-last
exercised): by `rfl`, i.e. this IS Core's definitional behavior. -/
theorem root_three_leaves (a b c : ByteArray) :
    merkleRootOf [a, b, c] = pairHash (pairHash a b) (pairHash c c) := rfl

/-! ## Concrete spot shapes (all `rfl` against Core's definitions) -/

/-- 1-tx shape: the root IS the leaf (genesis/91842 shape). -/
theorem shape_1 : shapeRoot 1 = dummyLeaf 0 := rfl

/-- The 1-tx dummy root equals the 32-zero null constant (`dummyLeaf 0`
is 32 zero bytes, and the 1-tx root is the leaf itself). -/
theorem shape_1_is_null : shapeRoot 1 = Bitcoin.Data.zeroBytes 32 := rfl

/-- 2-tx shape: `SHA256d(L0 ‖ L1)`. -/
theorem shape_2 : shapeRoot 2 = pairHash (dummyLeaf 0) (dummyLeaf 1) := rfl

/-- 3-tx shape over the dummy leaves: the odd level duplicates `L2`. -/
theorem shape_3 : shapeRoot 3 =
    pairHash (pairHash (dummyLeaf 0) (dummyLeaf 1))
      (pairHash (dummyLeaf 2) (dummyLeaf 2)) := rfl

/-! ## Per-row kernel theorems (small shapes) -/

theorem row_1 : rowCheck 1 = true := rfl

set_option maxRecDepth 8000 in
theorem row_2 : rowCheck 2 = true := rfl

set_option maxRecDepth 8000 in
theorem row_3 : rowCheck 3 = true := rfl

/-! ## THE 64-ROW MATRIX -/

/-- **All 64 roots agree with the independent Python reference**, one row
per tx-count `n = 1..64` — discharged by kernel conversion (`rfl`): Lean's
kernel evaluates Core's own `sha256d` over all ~6.8k compressions of the
64 shapes in one defeq check. Not `native_decide` — the footprint stays
`propext`/`Quot.sound`-class only. -/
set_option maxHeartbeats 10000000 in
set_option maxRecDepth 8000 in
theorem merkle_matrix_64 : matrixCheck = true := rfl

/-! ## Axiom footprints -/

#print axioms shapeRoot_fuel
#print axioms root_level_step
#print axioms root_three_leaves
#print axioms merkle_matrix_64

end BitcoinProofs.Theorems.Exhaust.MerkleShapes64
