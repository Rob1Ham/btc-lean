/-! ## The 64 fixed dummy leaves and Core's roots for every shape 1..64 -/

/-- Dummy leaf `i`: 32 bytes, every byte equal to `i` (mod 256). -/
def dummyLeaf (i : Nat) : ByteArray :=
  (List.range 32).foldl (fun a _ => a.push i.toUInt8) ByteArray.empty

/-- The 64 fixed dummy leaves, in order. -/
def leaves : List ByteArray := (List.range 64).map dummyLeaf

/-- The n-tx dummy leaf vector: the first `n` of the 64 leaves, in order. -/
def leavesOf (n : Nat) : List ByteArray := leaves.take n

/-- Core's merkle root for the n-tx dummy shape (`merkleRootOf`'s canonical
fuel `length + 1`). -/
def shapeRoot (n : Nat) : ByteArray := merkleRootOf (leavesOf n)


