  simp only [Except.bind.eq_2,
    v1_leaf_ver, v1_leaf_pc, v1_leaf_h, v1_leaf_n, v1_leaf_sl, v1_leaf_sb,
    v1_leaf_sq, v1_leaf_oc, v1_leaf_v, v1_leaf_osl, v1_leaf_osb, v1_leaf_lt,
    rdList, rdVin, rdVout]
  rfl

