    v4_leaf_ver, v4_leaf_pc, v4_leaf_fl, v4_leaf_vc, v4_leaf_h, v4_leaf_n,
    v4_leaf_sl, v4_leaf_sb, v4_leaf_sq, v4_leaf_oc, v4_leaf_v, v4_leaf_osl,
    v4_leaf_osb, v4_leaf_wc, v4_leaf_il, v4_leaf_i, v4_leaf_lt,
    v4_all_nonempty,
    rdList, rdVin, rdVout, rdStacks, rdStack, rdStack.rdItems]
  rfl

/-! ### Encode + rejection theorems -/

theorem v1_encode : encodeTx144 tx1 = v1 := by rfl
theorem v1_base : encodeTx144 tx1 = serTx tx1 :=
  enc_empty_witness_base tx1 (by simp [tx1, txHasWitness])
theorem v2_encode : encodeTx144 tx2 = v2 := by rfl
theorem v3_encode : encodeTx144 tx3 = v3 := by rfl
theorem v4_encode : encodeTx144 tx4 = v4 := by rfl
theorem v5_rejected : decodeTx144 v5 = .error .unknownFlag := by rfl
theorem v6_rejected : decodeTx144 v6 = .error .unknownFlag := by rfl
theorem v7_rejected : decodeTx144 v7 = .error .superfluousWitness := by rfl
theorem v8_empty_dummy : decodeTx144 v8 = .ok tx8 := by rfl

end BitcoinProofs.Bip.B10
