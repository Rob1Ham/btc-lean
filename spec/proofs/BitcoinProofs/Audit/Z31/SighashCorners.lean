/-- The sighash environment: official tx + official spent outputs. -/
def env9 : TapSighashEnv := ⟨txV, outsV⟩

/-- execdata: annex lane initialized, NO annex (official key-path cases). -/
def edNone : ScriptExecutionData := { annexInit := true }

/-- execdata: annex PRESENT with the correct BIP341 `sha_annex`
(CompactSize prefix; Core interpreter.cpp:1964). -/
def edAnnex : ScriptExecutionData :=
  { annexInit := true, annexPresent := true, annexHash := shaAnnex annex13 }


/-! ## decide lane — structural facts (no hashing) -/

/-- TPR-039 + TPR-043: spend_type = ext_flag*2 + annex_present over the
whole (ext_flag, annex) matrix; ext_flag TAPROOT⇒0 / TAPSCRIPT⇒1, other
sigversions fail closed (Core asserts). -/
theorem extflag_spendtype_matrix :
    extFlagOf SigVersion.taproot = some 0
    ∧ extFlagOf SigVersion.tapscript = some 1
    ∧ extFlagOf SigVersion.witnessV0 = none
    ∧ spendType 0 false = 0 ∧ spendType 0 true = 1
    ∧ spendType 1 false = 2 ∧ spendType 1 true = 3 := by decide

/-- C2 core fact (Core :1509-1511): hashtype 0x00's branch profile is
EXACTLY SIGHASH_ALL's — ALL output branch, non-ACP input, no NONE, no
SINGLE, and 0x00 is inside the valid-hashtype domain (TPR-030). -/
theorem sighash_default_branch_profile :
    htOutputAll 0x00 = true ∧ htAcp 0x00 = false
    ∧ htNone 0x00 = false ∧ htSingle 0x00 = false
    ∧ hashtypeValid 0x00 = true
    ∧ htOutputAll 0x01 = true ∧ htAcp 0x01 = false
    ∧ htNone 0x01 = false ∧ htSingle 0x01 = false := by decide

/-- C2 (Core interpreter.h:37): SIGHASH_DEFAULT IS the byte 0x00. -/
theorem sighash_default_is_zero : SIGHASH_DEFAULT = 0x00 := rfl

/-! ## #eval lane — computed cases through the real defs (python-anchored) -/

/-- A check that contributes its label to the failure list when false. -/
def chk (s : String) (ok : Bool) : String :=
  if ok then "" else s ++ " "

/-- The B13SigMsg embedded `sha_annex` digest of annex13 (python H1:
SHA256(0x11 ‖ annex13) — CompactSize prefix, annex INCLUDING 0x50). -/
def shaAnnex13 : ByteArray :=
  fromHex "acef2e4cead64fe930e6673fbe48adb290c09450f96c2c5d41bad4e6ad0eea03"

/-- B13's 206-byte ALL+annex sigMsg literal (TPR-033 order; python H3
rebuild matches byte-for-byte; B13SigMsg.sigmsg_all_annex pins it). -/
def allAnnexMsg : ByteArray :=
  fromHex ""

/-- B13's 206-byte SINGLE+annex sigMsg literal (annex slot BETWEEN the
input index and sha_single_output; B13SigMsg.sigmsg_single_annex). -/
def singleAnnexMsg : ByteArray :=
  fromHex ""

/-- B13's 174-byte SIGHASH_DEFAULT sigMsg literal — ALL-shape (TPR-038
output branch present, TPR-034..037 sub-hashes, spend_type 0x00). -/
def defaultMsg : ByteArray :=
  fromHex ""

/-- The official-shape ALL sigMsg (differs from `defaultMsg` in byte 0
ONLY — python G2). -/
def allMsg : ByteArray :=
  fromHex ""

/-- B13's SIGHASH_DEFAULT key-path sighash literal (TPR-032 epoch +
TapSighash tag; python G3 re-derives it from defaultMsg). -/
def sighashDefault : ByteArray :=
  fromHex "f4b7d7c520325939370e4598ac01946b6fc6edf7fe2325f434ff1b061f1834e3"

/-- A 0x50-led 64-byte "signature" (the singleton-annex hazard: a key-path
sig whose first byte happens to be the annex tag). -/
def sig50 : ByteArray := ByteArray.mk (#[(0x50 : UInt8)] ++ Array.replicate 63 (0x01 : UInt8))

/-- A 64-byte BIP340 signature body (arbitrary; only sizes/bytes matter
for the hashtype split). -/
def sigBody : ByteArray := ByteArray.mk (Array.replicate 64 (0x01 : UInt8))

/-! ### C1 — ext-flags + annex framing (10 checks) -/

def secC1 : String :=
  let mAA := (sigMsgTaproot env9 0 0x01 SigVersion.taproot edAnnex).get!
  let mSA := (sigMsgTaproot env9 0 0x03 SigVersion.taproot edAnnex).get!
  let fails : String :=
    -- the message IS the official-shape ALL+annex literal
    chk "c1.allAnnex.literal"  (mAA == allAnnexMsg) ++
    -- spend_type byte idx169 = 0x01 = ext_flag(0)<<1 | annex_present(1)
    chk "c1.allAnnex.spendType" (mAA.data.toList.getD 169 0 == 0x01) ++
    -- the annex slot occupies bytes [174, 206) == sha_annex (CompactSize
    -- prefix, 0x50 included) — python H1/H3
    chk "c1.allAnnex.slot"     (mAA.data.toList.drop 174 == (shaAnnex annex13).data.toList) ++
    chk "c1.shaAnnex.literal"  (shaAnnex annex13 == shaAnnex13) ++
    -- SINGLE+annex: spend_type idx137 = 0x01; annex slot [142,174) —
    -- BETWEEN input_index and sha_single_output (Core :1547-1566 order)
    chk "c1.singleAnnex.literal" (mSA == singleAnnexMsg) ++
    chk "c1.singleAnnex.spendType" (mSA.data.toList.getD 137 0 == 0x01) ++
    chk "c1.singleAnnex.slot"  ((mSA.data.toList.drop 142 |>.take 32) == (shaAnnex annex13).data.toList) ++
    -- TPR-005 boundaries (Core :1907): 2 items + 0x50-led last ⇒ annex;
    -- a SINGLETON 0x50-led item is NOT an annex (a key-path sig may
    -- start with 0x50); empty last item; wrong tag 0x51
    chk "c1.isAnnex.pos"       (isAnnex [sigBody, fromHex "5001"] = true) ++
    chk "c1.isAnnex.singleton" (isAnnex [sig50] = false) ++
    chk "c1.isAnnex.emptyLast" (isAnnex [sigBody, ByteArray.empty] = false) ++
    chk "c1.isAnnex.wrongTag"  (isAnnex [sigBody, fromHex "5101"] = false) ++
    -- the annex is POPPED before spend dispatch (TPR-007 + TPR-005):
    -- [sig, annex] classifies as KEY PATH over sig, annex not a script
    chk "c1.classify.pop"      (classifySpend [sigBody, fromHex "5001"]
                                  = .keyPath sigBody) ++
    ""
  if fails == "" then "C1: 12/12 OK"
  else "FAILURES: " ++ fails

/-- info: "C1: 12/12 OK" -/
#guard_msgs in #eval secC1

/-! ### C2 — SIGHASH_DEFAULT = 0x00 is ALL semantics (9 checks) -/

def secC2 : String :=
  let mD := (sigMsgTaproot env9 0 0x00 SigVersion.taproot edNone).get!
  let mA := (sigMsgTaproot env9 0 0x01 SigVersion.taproot edNone).get!
  let fails : String :=
    -- the DEFAULT message IS the official-shape ALL literal modulo byte 0
    chk "c2.msg.literal"       (mD == defaultMsg) ++
    -- DECISIVE: DEFAULT and ALL sigMsgs are IDENTICAL except the
    -- hashtype byte — no distinct message mode exists (python G2)
    chk "c2.msg.allExceptByte0" (mD.data.toList.drop 1 == mA.data.toList.drop 1) ++
    chk "c2.msg.differs.byte0"  (mD.data.toList.getD 0 0 == 0x00
                                          && mA.data.toList.getD 0 0 == 0x01) ++
    -- the ALL-branch fields are present in the DEFAULT message: len 174
    -- (=142 + 32 sha_outputs) and the digests equal ALL's
    chk "c2.msg.len174"        (mD.data.toList.length == 174) ++
    chk "c2.msg.outputsEq"     ((mD.data.toList.drop 138 |>.take 32) == (mA.data.toList.drop 138 |>.take 32)) ++
    -- the full sighash under DEFAULT (epoch + TapSighash tag)
    chk "c2.sighash.literal"   ((sighashTaproot env9 0 0x00 SigVersion.taproot edNone).get!
                                  == sighashDefault) ++
    -- 64-byte sig ⇒ IMPLICIT DEFAULT (Core :1686-1688)
    chk "c2.sig64"             (schnorrHashtype sigBody
                                  == some (sigBody, SIGHASH_DEFAULT)) ++
    -- 65-byte sig with trailing 0x00 ⇒ hashtype ERROR (Core :1689) —
    -- DEFAULT exists ONLY as the missing/implicit byte
    chk "c2.sig65default.rej"  (schnorrHashtype (sigBody.push 0x00) == none) ++
    -- 65-byte sig with explicit non-DEFAULT hashtype ⇒ popped body+byte
    chk "c2.sig65explicit"     (schnorrHashtype (sigBody.push 0x01)
                                  == some (sigBody, 0x01)) ++
    ""
  if fails == "" then "C2: 9/9 OK"
  else "FAILURES: " ++ fails

/-- info: "C2: 9/9 OK" -/
#guard_msgs in #eval secC2

end Bitcoin.Proofs.Audit.Z31

