/-! ## Hex helper (test infra; Y01 pattern) -/

def hexDigitVal (c : Char) : Option Nat :=
  let n := c.toNat
  if 48 ≤ n ∧ n ≤ 57 then some (n - 48)
  else if 97 ≤ n ∧ n ≤ 102 then some (n - 87)
  else if 65 ≤ n ∧ n ≤ 70 then some (n - 55)
  else none

def fromHex (s : String) : ByteArray :=
  go s.toList ByteArray.empty
where
  go : List Char → ByteArray → ByteArray
    | [], acc => acc
    | [_], acc => acc
    | a :: b :: rest, acc =>
        match hexDigitVal a, hexDigitVal b with
        | some ha, some hb => go rest (acc.push ((ha * 16 + hb).toUInt8))
        | _, _ => go rest acc

/-- List (Bytes) view of a hex string — the wire layer (`decStackL`/
`encStackL`) operates on `Bytes = List UInt8`, not `ByteArray`. -/
def hexB (s : String) : Bytes := (fromHex s).data.toList

/-! ## Harness: stub checker + flag words (VERIFIED shared parameters) -/

/-- Lean core ships no `DecidableEq (Except α β)`; the wire-layer vectors
decide on `Except` equalities, so provide it locally (Y01 pattern). -/
instance instDecEqExcept {α β : Type} [DecidableEq α] [DecidableEq β] :
    DecidableEq (Except α β)
  | .error e, .error e' =>
      match decEq e e' with
      | isTrue h => isTrue (by rw [h])
      | isFalse h => isFalse (by intro h2; exact h (Except.error.inj h2))
  | .ok a, .ok b =>
      match decEq a b with
      | isTrue h => isTrue (by rw [h])
      | isFalse h => isFalse (by intro h2; exact h (Except.ok.inj h2))
  | .error _, .ok _ => isFalse (by intro h; simp at h)
  | .ok _, .error _ => isFalse (by intro h; simp at h)

def ckGood : ScriptChecker := ⟨stubChecker, default, none⟩
def flW : ScriptFlags := { witness := true }
def flWT : ScriptFlags := { witness := true, taproot := true }
def polDef : PolicyFlags := default
def polDisc : PolicyFlags := { discourageUpgradableWitnessProgram := true }


