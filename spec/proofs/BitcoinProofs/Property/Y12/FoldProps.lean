open Bitcoin.Data Bitcoin.Ledger Bitcoin.TxValidation

set_option maxRecDepth 100000
set_option maxHeartbeats 10000000

/-! ## Hex helpers (test infra only; local copy of the Y01 pattern) -/

def hexDigitVal (c : Char) : Option Nat :=
  let n := c.toNat
  if 48 ≤ n ∧ n ≤ 57 then some (n - 48)        -- '0'..'9'
  else if 97 ≤ n ∧ n ≤ 102 then some (n - 87)  -- 'a'..'f'
  else if 65 ≤ n ∧ n ≤ 70 then some (n - 55)   -- 'A'..'F'
  else none

def fromHex (s : String) : ByteArray :=
  go s.toList ByteArray.empty
where
  go : List Char → ByteArray → ByteArray
    | [], acc => acc
    | [_], acc => acc
    | a :: b :: rest, acc =>
        match hexDigitVal a, hexDigitVal b with
        | some ha, some hb => go rest (acc.push ((ha * 16 + hb).toUInt8))
        | _, _ => go rest acc

-- NOTE: all byte comparisons below use direct `ByteArray ==` (O(1)/byte);
-- `List Nat` + unary `Nat.decEq` needs ~255 whnf steps per byte, which
-- blows maxHeartbeats on the 10000-byte-script cases D9/D10
-- (precheck2.log:592). A dangling `/-- … -/` docstring here (not attached
-- to a declaration) is a PARSE error — keep these as `--` comments.

/-! ## Verdict equality (structural; `DecidableEq (OutPoint × Coin)` is not
derived in the frozen data model, so compare via `ByteArray` equality) -/

def outEq (a b : OutPoint) : Bool := a.hash == b.hash && a.n == b.n

def coinEq (a b : Coin) : Bool :=
  a.value == b.value && a.height == b.height &&
    a.isCoinbase == b.isCoinbase && a.scriptPubKey.bytes == b.scriptPubKey.bytes

def entEq (a b : OutPoint × Coin) : Bool := outEq a.1 b.1 && coinEq a.2 b.2

def lstEq : List (OutPoint × Coin) → List (OutPoint × Coin) → Bool
  | [], [] => true
  | x :: xs, y :: ys => entEq x y && lstEq xs ys
  | _, _ => false

def verdEq (a b : Except BlockError (List (OutPoint × Coin))) : Bool :=
  match a, b with
  | .error e, .error e' => e == e'
  | .ok l, .ok l' => lstEq l l'
  | _, _ => false

/-! ## Constructors (test infra) -/

/-- FIX D4c-2 (BIP30R-5) row helper: the `.ok` verdict probe (the BIP30
rows that flipped to ok carry their expected final view where needed). -/
def isOkBEX (l : List (OutPoint × Coin)) (txs : List Tx) (h : UInt32) : Bool :=
  match applyBlockExec l txs h with
  | Except.ok _ => true
  | Except.error _ => false

def isOkBH (l : List (OutPoint × Coin)) (txs : List Tx) (h : UInt32) : Bool :=
  isOkBEX l txs h

def opOf (h : String) (n : UInt32) : OutPoint := ⟨fromHex h, n⟩
def coinOf (v : Int) (h : UInt32) (cb : Bool) (s : String) : Coin :=
  ⟨v, h, cb, ⟨fromHex s⟩⟩
def tin (h : String) (n : UInt32) : TxIn := ⟨⟨fromHex h, n⟩, Script.empty, 0xFFFFFFFF⟩
/-- The coinbase input's null prevout (`OutPoint.null`). -/
def cbIn : TxIn := ⟨OutPoint.null, Script.empty, 0xFFFFFFFF⟩
def tout (v : Int) (s : String) : TxOut := ⟨v, ⟨fromHex s⟩⟩
def mktx (vin : List TxIn) (vout : List TxOut) : Tx := ⟨1, vin, vout, 0, []⟩

/-! ## Named structural pins (sorry-free, `rfl`) -/

theorem applyBlockExec_nil (l : List (OutPoint × Coin)) (h : UInt32) :
    applyBlockExec l [] h = Except.ok l := rfl

/-- The fold is literally one `applyTxStepL` per tx, threaded — B3's
same-block spend ordering IS this recursion.
FIX D4c-2 (BIP30R-5): post-D4c-2 `applyBlockL` is the pre-loop
`bip30BlockCollision`-gated wrapper (validation.cpp:2466-2475, pristine
`viewOf l`, ONCE) in front of `applyBlockFoldL`, so the bare `rfl`
cons-step no longer holds; this is the Mempool `applyBlockU_cons_ok_step`
mirror (TXV-065): with both BIP30 gates quiet, the step + fold
recursion collapses — one `applyTxStepL` per tx, threaded. -/
theorem applyBlockL_cons_step (l : List (OutPoint × Coin)) (kf : Tx → Key)
    (tx : Tx) (txs : List Tx) (h : UInt32)
    (haok : applyTxStepL l tx (kf tx) h = Except.ok (updateCoinsL l tx (kf tx) h))
    (hb30g : (bip30BlockCollision (viewOf l) kf (tx :: txs) h && bip30Enforced h) = false)
    (hb30g' : (bip30BlockCollision (viewOf (updateCoinsL l tx (kf tx) h)) kf txs h
        && bip30Enforced h) = false) :
    applyBlockL l kf (tx :: txs) h =
      applyBlockL (updateCoinsL l tx (kf tx) h) kf txs h := by
  have hbgN : ¬((bip30BlockCollision (viewOf l) kf (tx :: txs) h
      && bip30Enforced h) = true) := by
    rw [hb30g]; simp
  have hbgN' : ¬((bip30BlockCollision (viewOf (updateCoinsL l tx (kf tx) h)) kf txs h
      && bip30Enforced h) = true) := by
    rw [hb30g']; simp
  unfold applyBlockL
  rw [if_neg hbgN, if_neg hbgN']
  rw [applyBlockFoldL]
  rw [haok]
  rfl

/-- Check-order pin: with the BIP30 gate quiet, a coinbase tx skips the
input/maturity gates entirely (Core: `UpdateCoins` only).
FIX D4c-2 (BIP30R-5): post-D4c-2 `applyTxStepU` has NO BIP30 branch
(the duplicate check is the block-level pre-loop gate in `applyBlockU`),
so the `hbip` side condition is vestigial and DROPPED (the theorem is
now strictly stronger: the coinbase leg is `rfl`). -/
theorem step_coinbase_skips_gates (u : UtxoSet) (tx : Tx) (key : Key) (h : UInt32)
    (hcb : tx.isCoinBase = true) :
    applyTxStepU u tx key h = Except.ok (updateCoins u tx key h) := by
  unfold applyTxStepU
  rw [hcb]
  rfl

