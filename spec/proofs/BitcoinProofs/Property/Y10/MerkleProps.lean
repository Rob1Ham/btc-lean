/-- The all-zero leaf literal agrees with `Bitcoin.Data.zeroBytes 32`
(the coinbase witness-leaf constant, BLK-014). -/
example : Z32 = zeroBytes 32 := rfl

/-- A 32-byte FF literal roundtrips through `fromHex` unharmed. -/
example : Z32.size = 32 ∧ FF32.size = 32 := by decide

/-! ## 0. Structural laws (hash-free, rfl) -/

theorem root_nil : merkleRootOf [] = zeroBytes 32 := rfl

theorem root_singleton (a : ByteArray) : merkleRootOf [a] = a := rfl

theorem root_pair (a b : ByteArray) : merkleRootOf [a, b] = pairHash a b := rfl

/-- 3 leaves: the odd level duplicates the last BEFORE pairing. -/
theorem root_triple (a b c : ByteArray) :
    merkleRootOf [a, b, c] = pairHash (pairHash a b) (pairHash c c) := rfl

/-- 5 leaves: two odd levels (3 and 1 wide) — duplicate-last fires twice. -/
theorem root_quint (a b c d e : ByteArray) :
    merkleRootOf [a, b, c, d, e] =
      pairHash (pairHash (pairHash a b) (pairHash c d))
               (pairHash (pairHash e e) (pairHash e e)) := rfl

/-- `merkleLevel` of a singleton self-pairs (this is the duplicate-last
rule in isolation; `merkleRootOfF` itself stops at size 1). -/
theorem level_singleton (a : ByteArray) : merkleLevel [a] = [pairHash a a] := rfl


