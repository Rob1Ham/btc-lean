import Bitcoin.Capstone.Merkle

/-!
# Y10 property-test corpus — Capstone/Merkle (BLK-005..BLK-013 core)

2026-10-16.

Ground truth: Bitcoin Core `consensus/merkle.cpp` @ `c50817f` (fetched from
github.com/bitcoin/bitcoin at that pinned commit):
`ComputeMerkleRoot` folds level-by-level; an
odd-sized level duplicates its LAST element before pairing (BLK-008 —
the CVE-2012-2459 duplicate-last rule); a pair hash is
`SHA256d(left ‖ right)` (BLK-009); `[]` ⇒ 32 zero bytes (BLK-013).

Corpus generated by a plain-python reference (hashlib-based, independent
of the Lean implementation), seed 20261016, REPRODUCIBLE. 88 root/level
cases below plus rfl-level structural laws.

Tactic doctrine (`Test/Crypto/SeamHashTest.lean` L1 rule): the hash
floor's 64-round compression does NOT whnf-reduce under plain kernel
`decide`, so every hash-crossing case is `native_decide` (the compiler
evaluates the real SHA-256; per-case bridge axiom documented below;
zero `sorryAx`). Hash-free structural cases
(`caseb01`, the size example) stay kernel `decide`; the closed-form laws
(`root_nil` .. `level_singleton`) are `rfl`.

Sections:
  A  systematic tx-counts n = 1..40 (odd/even level alternation)
  B  one-level `merkleLevel` structure incl. the singleton self-pair
  C  duplicate-last closed-form identities (rfl where hash-free)
  D  CVE-2012-2459 duplicate-tail shapes (equal/different roots)
  E  order sensitivity
  F  pseudo-random windows/subsets, fixed seed 20261016
  G  witness-tree-shaped leaves (`Z32 :: wtxids`, BLK-014 leaf layer)

The corpus tests the pure ByteArray merkle core (`merkleLevel`,
`merkleRootOf`, `pairHash`), which is the semantics carrier of
`merkleRootOfBlock`/`witnessMerkleRoot` (leaf layers are `map txidOf`
resp. `Z32 :: map wtxidOf`, both tested at Tx level).
-/

namespace BitcoinProofs.Property.Y10.MerkleProps

open Bitcoin.Capstone.Merkle Bitcoin.Crypto.Seam.Hash Bitcoin.Data

set_option maxRecDepth 10000
set_option maxHeartbeats 2000000

/-! ## Hex helpers (test infra only; local copy of the Y01 pattern) -/

def hexDigitVal (c : Char) : Option Nat :=
  let n := c.toNat
  if 48 ≤ n ∧ n ≤ 57 then some (n - 48)        -- '0'..'9'
  else if 97 ≤ n ∧ n ≤ 102 then some (n - 87)  -- 'a'..'f'
  else if 65 ≤ n ∧ n ≤ 70 then some (n - 55)   -- 'A'..'F'
  else none

def fromHex (s : String) : ByteArray :=
  go s.toList ByteArray.empty
where
  go : List Char → ByteArray → ByteArray
    | [], acc => acc
    | [_], acc => acc
    | a :: b :: rest, acc =>
        match hexDigitVal a, hexDigitVal b with
        | some ha, some hb => go rest (acc.push ((ha * 16 + hb).toUInt8))
        | _, _ => go rest acc

