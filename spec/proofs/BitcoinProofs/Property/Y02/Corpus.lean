-- CS-OK-0: canonical encCSL/decCS boundary value 0
theorem cs_ok_0 : decCS (hex "00") = .ok (0, []) := by decide
-- CS-OK-1: canonical encCSL/decCS boundary value 1
theorem cs_ok_1 : decCS (hex "01") = .ok (1, []) := by decide
-- CS-OK-2: canonical encCSL/decCS boundary value 252
theorem cs_ok_2 : decCS (hex "fc") = .ok (252, []) := by decide
-- CS-OK-3: canonical encCSL/decCS boundary value 253
theorem cs_ok_3 : decCS (hex "fdfd00") = .ok (253, []) := by decide
-- CS-OK-4: canonical encCSL/decCS boundary value 65535
theorem cs_ok_4 : decCS (hex "fdffff") = .ok (65535, []) := by decide
-- CS-OK-5: canonical encCSL/decCS boundary value 65536
theorem cs_ok_5 : decCS (hex "fe00000100") = .ok (65536, []) := by decide
-- CS-OK-6: canonical encCSL/decCS boundary value 16777215
theorem cs_ok_6 : decCS (hex "feffffff00") = .ok (16777215, []) := by decide
-- CS-OK-7: canonical encCSL/decCS boundary value 33554432
theorem cs_ok_7 : decCS (hex "fe00000002") = .ok (33554432, []) := by decide

-- CS-BAD-0: 252 claimed via 0xfd
theorem cs_bad_0 : decCS (hex "fdfc00") = .error .compactSizeNonMinimal := by decide
-- CS-BAD-1: 65535 claimed via 0xfe
theorem cs_bad_1 : decCS (hex "feffff0000") = .error .compactSizeNonMinimal := by decide
-- CS-BAD-2: 0xffffffff claimed via 0xff (< 2^32)
theorem cs_bad_2 : decCS (hex "ffffffffff00000000") = .error .compactSizeNonMinimal := by decide
-- CS-BAD-3: 2^32 via 0xff, > MAX_SIZE
theorem cs_bad_3 : decCS (hex "ff0000000001000000") = .error .compactSizeTooLong := by decide
-- CS-BAD-4: 0xfd with 1 payload byte
theorem cs_bad_4 : decCS (hex "fd01") = .error .truncated := by decide
-- CS-BAD-5: 0xfe with 3 payload bytes
theorem cs_bad_5 : decCS (hex "fe010000") = .error .truncated := by decide
-- CS-BAD-6: 0xff with 5 payload bytes
theorem cs_bad_6 : decCS (hex "ff0100000000") = .error .truncated := by decide
-- CS-BAD-7: empty input
theorem cs_bad_7 : decCS (hex "") = .error .truncated := by decide
-- CS-BAD-8: 0xfe-enc 0x03000000 > MAX_SIZE
-- DIVERGENCE (F-Y02-001): Core ReadCompactSize range-checks the
-- 0xfe branch too and throws "size too large"; W02's decCS does
-- not -> Lean ACCEPTS. Lean's actual verdict asserted here.
theorem cs_bad_8 : decCS (hex "fe00000003") = .ok (50331648, []) := by decide
-- CS-BAD-9: 0xfe-enc 0x02000001 > MAX_SIZE
-- DIVERGENCE (F-Y02-001): Core ReadCompactSize range-checks the
-- 0xfe branch too and throws "size too large"; W02's decCS does
-- not -> Lean ACCEPTS. Lean's actual verdict asserted here.
theorem cs_bad_9 : decCS (hex "fe01000002") = .ok (33554433, []) := by decide

-- the public ByteArray-level API (frozen interface members), boundary set
theorem pub_cs_253 : decodeCompactSize (fromHex "fdfd00") 0 = some (253, 3) := by decide
theorem pub_cs_65536 : decodeCompactSize (fromHex "fe00000100") 0 = some (65536, 5) := by decide
theorem pub_cs_33554432 : decodeCompactSize (fromHex "fe00000002") 0 = some (33554432, 5) := by decide
theorem pub_cs_1 : decodeCompactSize (fromHex "01") 0 = some (1, 1) := by decide

-- OBSERVATION (F-Y02-003): decodeCompactSize (C1 compactSizeDec) performs
-- NO canonicality check; Core ReadCompactSize rejects non-minimal
-- encodings in EVERY range_check mode. Lean actual asserted.
theorem pub_cs_noncanonical : decodeCompactSize (fromHex "fdfc00") 0 = some (252, 3) := by decide

