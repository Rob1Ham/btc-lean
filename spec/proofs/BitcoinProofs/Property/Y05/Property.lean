    1755926290448384 := by
  rw [cve2010_5137_true_sum]; rfl

/-! ## 7. Named instances of the frozen W04 theorems (axiom footprint
pinned in scratch/Y05/axioms.lean) -/

theorem y05_feeInRange_instance :
    MoneyRange (feeOf 200000000 150000000) = true :=
  fee_in_money_range 200000000 150000000 (by decide) (by decide) (by decide)

theorem y05_fee_nonneg_iff_instance :
    (0 : Amount) ≤ feeOf 400 1000 ↔ (1000 : Amount) ≤ 400 :=
  feeOf_nonneg_iff 400 1000

theorem y05_moneyRange_elim_instance :
    0 ≤ (MAX_MONEY : Amount) ∧ MAX_MONEY ≤ MAX_MONEY :=
  moneyRange_elim (by decide)

theorem y05_checkedSum_sound_instance :
    checkedSum ([100000000, 5000, 25000] : List Amount) = some 100030000 ∧
    MoneyRange 100030000 = true :=
  by
    have h : checkedSum ([100000000, 5000, 25000] : List Amount)
        = some 100030000 := by decide
    exact ⟨h, (checkedSum_sound _ _ h).2⟩

end BitcoinProofs.Property.Y05
