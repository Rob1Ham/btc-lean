import Bitcoin.Data.Tx
import Bitcoin.Activation.Interface

/-!
# BitcoinVectors — typed conformance-vector records (W07)

The corpus records in `BitcoinVectors.Gen.*` are GENERATED by
`spec/scripts/runners/codegen.py` from the vendored, hash-pinned corpora in
`spec/vectors/` (see `spec/vectors/MANIFEST.sha256` for sources + hashes).

Design (report `research/w2-07-vector-runner.md` §2):

* Hex fields are compiled to `ByteArray` literals (`ByteArray.mk #[..]`) so
  the SAME records feed (a) the compiled `vectorrunner` exe and (b) the
  codegen'd `decide`-theorem tier — one ingest, two consumers.
* Core's scriptVerify flag string is decoded to the consensus
  `Activation.ScriptFlags` record AT CODEGEN TIME (the consensus subset per
  B2: {P2SH, DERSIG, CLTV, CSV, NULLDUMMY, WITNESS, TAPROOT}); policy-only
  flag names are preserved verbatim in `policyFlags` for provenance.
* Vector IDs are stable selectors used by `spec/db/vector_ids.yaml`
  (rule ↔ vector mapping) and `spec/db/results.json` (runner output).
-/

namespace BitcoinVectors

open Bitcoin.Data Bitcoin.Activation

/-- ByteArray literal helper for generated data. -/
abbrev bytes (a : Array UInt8) : ByteArray := ByteArray.mk a

/-- One `tx_valid.json` / `tx_invalid.json` case. -/
structure TxVec where
  id : String               -- "tv-NNN" (valid) / "ti-NNN" (invalid)
  tx : Tx                   -- decoded by the codegen reference decoder
  segwit : Bool             -- BIP144 marker/flag framing present
  flags : ScriptFlags       -- consensus subset of the verify-flags string
  policyFlags : String      -- policy-only flag names, verbatim ("" if none)
  expectValid : Bool        -- accept-bit expectation
  comment : String          -- leading Core comment line ("" if none)
  -- C02 ser_decode layer: the case's RAW wire bytes, verbatim from the
  -- corpus (tx_*.json entry[1] hex, compiled to a ByteArray literal by
  -- codegen). `tx` is the codegen reference decode of the SAME bytes, so
  -- `decodeTx rawTx` (W02) is adjudicated against it — see
  -- `serDecodeVerdict` in `BitcoinVectors.Backend`. Default = empty
  -- (hand-built records that carry no wire bytes; not ser_decode-judged).
  rawTx : ByteArray := ByteArray.empty
  -- W10 contextual layer: per-input prevout table, in `tx.vin` order —
  -- (txid wire bytes (display hex reversed), input index, prev scriptPubKey,
  --  prev amount). Amount = -1 when the corpus omits the value (feeless
  -- row); such rows are adjudicated only on the stateless+HaveInputs slice.
  prevouts : List (ByteArray × UInt32 × ByteArray × Amount) := []

/-- One `script_tests.json` vector row. -/
structure ScrVec where
  id : String               -- "sc-NNNN"
  scriptSig : ByteArray
  scriptPubKey : ByteArray
  witness : List ByteArray  -- [] when the row has no witness array
  value : Amount := 0       -- DoTest nValue (script_tests.cpp:926-955): the
                            -- witness array's trailing amount (sats; the
                            -- BIP143 sighash input), 0 when absent
  flags : ScriptFlags
  policyFlags : String
  expectOk : Bool           -- expected_scriptError == "OK"
  expectedError : String    -- Core's SCRIPT_ERR vocabulary, verbatim
  comment : String

/-- One `sighash.json` case (legacy SignatureHash corpus; 500 rows). -/
structure SghVec where
  id : String               -- "sh-NNN"
  rawTx : ByteArray         -- undecoded (decodeTx is W02's; stub runner status)
  scriptCode : ByteArray
  inputIndex : Nat
  hashType : UInt32         -- JSON stores it as a signed 32-bit value
  expected : ByteArray      -- expected signature hash (32 bytes)

/-- One `bip-0340/test-vectors.csv` row (BIP340 Schnorr). -/
structure Bip340Vec where
  id : String               -- "b340-NN"
  pubKey : ByteArray
  msg : ByteArray
  sig : ByteArray
  expectVerify : Bool
  comment : String

end BitcoinVectors
