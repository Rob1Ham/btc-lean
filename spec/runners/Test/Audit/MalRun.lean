import Bitcoin.Activation.Interface
import Bitcoin.Interpreter.Defs
import Bitcoin.Crypto.Seam.Mock
import Test.Audit.MalGen

/-!
# MAL mutation driver (CV06 analysis suite)

Runs every BIP62-era malleability mutant (Test.Audit.MalGen, generated by
build/scratch/Asuite/CV06/gen_mal.py) through the REAL W09
checker `Bitcoin.Interpreter.verifyScriptFull` over the run matrix
(consensus flags pre/post-BIP66/today + policy bits) and asserts each
expectation (Core cce32b168 python mirror; see gen_mal.py docstring).

EC verdicts ride `Bitcoin.Crypto.Seam.Mock.mockChecker` with the row's
`(sig, pk) → true` table (Core script-test framework semantics), so the
encoding/push/policy gates are the object of study, not EC math.

Run (from spec/runners; cf. cve_replay.py):
    LEAN_PATH="<runners>/.lake/build/lib/lean:<core>/.lake/build/lib/lean" \
      lean -o .lake/build/lib/lean/Test/Audit/MalGen.olean \
                 Test/Audit/MalGen.lean
    LEAN_PATH=... lean --run Test/Audit/MalRun.lean
-/

namespace BitcoinVectors.MalRun

open BitcoinVectors.Mal Bitcoin.Activation Bitcoin.Interpreter
open Bitcoin.Crypto.Seam.Mock (mockChecker)

def js (s : String) : String := "\"" ++ s ++ "\""

def errName : Bitcoin.Interpreter.ExecError → String
  | .evalFalse => "evalFalse"
  | .badOpcode => "badOpcode"
  | .pushSize => "pushSize"
  | .opCount => "opCount"
  | .stackSize => "stackSize"
  | .sigPushOnly => "sigPushOnly"
  | .sigDer => "sigDer"
  | .sigHighS => "sigHighS"
  | .sigHashType => "sigHashType"
  | .sigNullDummy => "sigNullDummy"
  | .pubKeyType => "pubKeyType"
  | .minimalData => "minimalData"
  | .minimalIf => "minimalIf"
  | .cleanstack => "cleanstack"
  | .witnessMalleated => "witnessMalleated"
  | .witnessMalleatedP2SH => "witnessMalleatedP2SH"
  | _ => "other"

def runOne (r : MalVec) : List (String × String × Bool) :=
  r.runs.map fun (lab, flags, pol, exp) =>
    let chk : ScriptChecker := { base := mockChecker r.mock }
    let n := r.scriptSig.size + r.scriptPubKey.size + 2
    let got : String :=
      match verifyScriptFull n flags pol r.scriptSig r.scriptPubKey [] chk with
      | .ok => "ok"
      | .fail e => errName e
      | .unjudged => "unjudged"
    (r.id ++ "/" ++ lab, got, got == exp)


end BitcoinVectors.MalRun
def main : IO Unit := do
  let rows : List (String × String × Bool) :=
    (BitcoinVectors.Mal.malCases.map BitcoinVectors.MalRun.runOne).foldl (· ++ ·) []
  for (id, got, ok) in rows do
    unless ok do
      IO.println ("FAIL " ++ BitcoinVectors.MalRun.js id ++ " got="
        ++ BitcoinVectors.MalRun.js got)
  let n := rows.length
  let pass := rows.foldl (fun a r => a + (if r.2.2 then 1 else 0)) 0
  IO.println ("{\"summary\": {\"total\": " ++ toString n
    ++ ", \"pass\": " ++ toString pass
    ++ ", \"fail\": " ++ toString (n - pass) ++ "}}")
  if pass != n then
    throw <| IO.userError "mal-pack: at least one mutant diverged"

